---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AccessibilityMenu from '../components/AccessibilityMenu.astro';
import LeadModal from '../components/LeadModal.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  image = '/og-default.png',
  canonical,
  noindex = false,
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site?.origin ?? 'https://citizenshiphub.com';
const canonicalUrl = canonical
  ? new URL(canonical, siteUrl).href
  : new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;
const pageTitle = title.includes('Citizenship Hub') ? title : `${title} · Citizenship Hub`;
const googleVerification = Astro.locals.runtime?.env?.GOOGLE_SITE_VERIFICATION;
const bingVerification = Astro.locals.runtime?.env?.BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Citizenship Hub" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Citizenship Hub — global passport rankings and citizenship guides" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#fbfaf7" />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <script is:inline>
      (function () {
        try {
          const root = document.documentElement;
          const get = (k, d) => {
            try {
              return localStorage.getItem(k) ?? d;
            } catch {
              return d;
            }
          };
          const theme = get('theme', 'system');
          const density = get('density', 'default');
          const textScale = get('text-scale', '1');
          const contrast = get('high-contrast', 'off');
          const motion = get('reduce-motion', 'off');

          root.dataset.theme = theme;
          root.dataset.density = density;
          root.dataset.textScale = textScale;
          root.classList.toggle('high-contrast', contrast === 'on');
          root.classList.toggle('reduce-motion', motion === 'on');

          const dark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          root.classList.toggle('dark', dark);

          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#121110' : '#fbfaf7');
        } catch (e) {}
      })();
    </script>

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      (function () {
        try {
          var metrics = {};
          var reported = false;
          function report() {
            if (reported) return;
            reported = true;
            if (Object.keys(metrics).length > 0) {
              try {
                // One beacon for all web vitals (was one beacon per metric → up to 5 writes/page).
                var payload = JSON.stringify({ type: 'web_vital', properties: { metrics: metrics } });
                navigator.sendBeacon('/api/track', new Blob([payload], { type: 'application/json' }));
              } catch (e) {}
            }
            if (maxDepth > 0) {
              try {
                var d = JSON.stringify({ type: 'scroll_depth', value: maxDepth, path: window.location.pathname });
                navigator.sendBeacon('/api/track', new Blob([d], { type: 'application/json' }));
              } catch (e) {}
            }
          }
          function observe(type, entryType) {
            try {
              new PerformanceObserver(function (list) {
                var entries = list.getEntries();
                for (var i = 0; i < entries.length; i++) {
                  var e = entries[i];
                  if (type === 'CLS' && e.hadRecentInput) continue;
                  var v = type === 'INP' ? e.duration : type === 'LCP' ? e.startTime : e.value;
                  if (type === 'INP') metrics[type] = Math.max(metrics[type] || 0, v);
                  else metrics[type] = v;
                }
              }).observe({ type: entryType, buffered: true });
            } catch (e) {}
          }
          observe('LCP', 'largest-contentful-paint');
          observe('CLS', 'layout-shift');
          try {
            new PerformanceObserver(function (list) {
              var entries = list.getEntries();
              for (var i = 0; i < entries.length; i++) {
                if (entries[i].name === 'first-contentful-paint') metrics['FCP'] = entries[i].startTime;
              }
            }).observe({ type: 'paint', buffered: true });
          } catch (e) {}
          try {
            new PerformanceObserver(function (list) {
              var entries = list.getEntries();
              for (var i = 0; i < entries.length; i++) {
                var e = entries[i];
                metrics['INP'] = Math.max(metrics['INP'] || 0, e.duration);
              }
            }).observe({ type: 'event', buffered: true, durationThreshold: 0 });
          } catch (e) {}
          try {
            var nav = performance.getEntriesByType('navigation')[0];
            if (nav && nav.responseStart) metrics['TTFB'] = nav.responseStart;
          } catch (e) {}
          var maxDepth = 0;
          function updateDepth() {
            var scrollTop = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0;
            var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            if (height <= 0) return;
            var pct = Math.round((scrollTop / height) * 100);
            if (pct > maxDepth) maxDepth = pct;
          }
          window.addEventListener('scroll', updateDepth, { passive: true });
          updateDepth();
          document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'hidden') report();
          });
          window.addEventListener('pagehide', report);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <AccessibilityMenu />
    <LeadModal />
  </body>
</html>
