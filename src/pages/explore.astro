---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Search } from 'lucide-react';
import { getWorldPaths } from '../lib/map';
import { STATUS_FILL, STATUS_LABEL, STATUS_BADGE } from '../lib/visa';
import { getDb } from '../lib/db/client';
import { listCountries } from '../lib/db/countries';

const db = getDb(Astro.locals);
const countries = await listCountries(db);
const paths = getWorldPaths();

const FILTER_STATUSES = ['visa-free', 'visa-on-arrival', 'eta', 'e-visa', 'visa-required'] as const;
const FEATURED_CODES = ['AE', 'US', 'GB', 'DE', 'IN', 'NG', 'BR', 'ES'];

const passports = [...countries].sort((a, b) => a.name.localeCompare(b.name));
const byCode = new Map(countries.map((c) => [c.code, c]));
const featured = FEATURED_CODES.filter((code) => byCode.has(code));

const requested = (Astro.url.searchParams.get('passport') ?? '').trim().toUpperCase();
const DEFAULT_PASSPORT = byCode.has(requested)
  ? requested
  : byCode.has('AE')
    ? 'AE'
    : (featured[0] ?? countries[0]?.code ?? 'IE');

const COUNTRIES = countries.map((c) => ({ code: c.code, name: c.name, flag: c.flag ?? '' }));
---

<BaseLayout
  title="Visa Explorer"
  description="See where any passport can travel visa-free, visa on arrival, ETA, or e-visa browse every destination by access status."
>
  <section>
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
      <nav class="mb-4 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="transition hover:text-slate-900">Home</a>
        <span aria-hidden="true" class="mx-1.5 text-slate-300">·</span>
        <span class="text-slate-700">Explorer</span>
      </nav>
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Visa explorer</h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        Pick a passport and browse every destination by access status visa-free, visa on arrival, ETA, e-visa, or visa
        required.
      </p>
    </div>
  </section>

  <div class="sticky top-16 z-30 border-b border-slate-200 bg-slate-50/90 backdrop-blur-xl">
    <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6">
      <div class="flex flex-wrap items-end gap-4">
        <div>
          <label for="passportSelect" class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-slate-500">
            Passport
          </label>
          <select
            id="passportSelect"
            class="min-w-[230px] rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 focus:border-gold-400 focus:outline-none focus:ring-2 focus:ring-gold-400/40"
          >
            {
              passports.map((p) => (
                <option value={p.code} selected={p.code === DEFAULT_PASSPORT}>
                  {p.flag ? `${p.flag} ` : ''}{p.name} ({p.code})
                </option>
              ))
            }
          </select>
        </div>

        <div class="min-w-[200px] flex-1">
          <label for="searchInput" class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-slate-500">
            Search a destination
          </label>
          <div class="relative">
            <Search
              className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
              aria-hidden="true"
            />
            <input
              id="searchInput"
              type="search"
              placeholder="e.g. Japan, Brazil…"
              class="w-full rounded-lg border border-slate-200 bg-white py-2 pl-9 pr-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-gold-400 focus:outline-none focus:ring-2 focus:ring-gold-400/40"
            />
          </div>
        </div>

        <div class="w-full">
          <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-slate-500">Quick switch</span>
          <div id="quickPicks" class="flex flex-wrap gap-2">
            {
              featured.map((code) => {
                const c = byCode.get(code)!;
                const active = code === DEFAULT_PASSPORT;
                return (
                  <button
                    type="button"
                    class:list={[
                      'qp inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm font-medium transition',
                      active
                        ? 'border-brand-700 bg-brand-700 text-slate-50'
                        : 'border-slate-200 bg-white text-slate-700 hover:border-brand-700 hover:text-brand-700',
                    ]}
                    data-code={code}
                    aria-pressed={active ? 'true' : 'false'}
                  >
                    {c.flag && <span aria-hidden="true">{c.flag}</span>}
                    {c.name}
                  </button>
                );
              })
            }
          </div>
        </div>
      </div>

      <div id="filterRow" role="group" aria-label="Filter by visa status" class="mt-4 flex flex-wrap gap-2">
        {
          FILTER_STATUSES.map((s) => (
            <button
              type="button"
              class:list={[
                'filter-chip inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm font-medium transition',
                'border-brand-700 bg-brand-50 text-brand-700',
              ]}
              data-status={s}
              aria-pressed="true"
            >
              <span class="inline-block h-2.5 w-2.5 rounded-sm" style={`background:${STATUS_FILL[s]}`}></span>
              {STATUS_LABEL[s]}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <section class="mx-auto max-w-7xl px-4 pt-6 sm:px-6">
    <p class="font-display text-xl text-slate-900" role="status" aria-live="polite">
      The <b id="passportNameLabel" class="text-brand-700">{byCode.get(DEFAULT_PASSPORT)?.name ?? DEFAULT_PASSPORT}</b>{' '}
      passport <b id="matchCount">0</b> matching destinations
    </p>
    <div id="countBadges" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-5"></div>
    <div
      id="stackbar"
      role="img"
      aria-label="Breakdown of destinations by visa status"
      class="mt-4 flex h-3.5 w-full overflow-hidden rounded-full bg-slate-200"
    ></div>
    <p id="loading" hidden class="mt-3 text-sm text-slate-400" role="status">Loading visa data…</p>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6">
    <div class="relative">
      <svg
        id="worldMap"
        viewBox="0 0 960 500"
        role="img"
        aria-label="World map colored by visa status for the selected passport"
        class="h-auto w-full rounded-2xl border border-slate-200 bg-white shadow-sm"
      >
        {
          paths.map((c) => (
            <path
              d={c.d}
              data-alpha2={c.iso2}
              data-name={c.name}
              class="country-path cursor-pointer transition-opacity duration-150"
              fill="var(--map-unknown)"
              stroke="var(--map-stroke)"
              stroke-width="0.5"
            ></path>
          ))
        }
      </svg>
      <div
        id="mapTooltip"
        hidden
        class="pointer-events-none fixed z-50 rounded-md bg-brand-700 px-2.5 py-1.5 text-xs text-slate-50"
      ></div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6">
    <div id="resultsList" class="space-y-8"></div>
    <p id="emptyState" hidden class="py-12 text-center text-slate-500">
      No destinations match these filters. Try clearing a filter or the search.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <h3 class="font-display text-lg text-slate-900">Want to see two passports side by side?</h3>
        <p class="mt-2 text-sm text-slate-600">Compare up to four passports and see exactly where they differ.</p>
        <a
          href="/compare/"
          class="mt-4 inline-block rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-800 transition hover:border-brand-700 hover:text-brand-700"
        >
          Open compare tool →
        </a>
      </div>
      <div class="rounded-2xl border border-gold-300 bg-gradient-to-br from-gold-50 to-white p-6">
        <h3 class="font-display text-lg text-slate-900">Not loving your options?</h3>
        <p class="mt-2 text-sm text-slate-600">
          See realistic routes to a stronger passport, matched to your situation.
        </p>
        <button
          type="button"
          data-lead-modal-open
          data-service-type="Golden Visa"
          class="mt-4 inline-block rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-slate-50 transition hover:bg-brand-800"
        >
          Find my path →
        </button>
      </div>
    </div>
  </section>

  <script define:vars={{ COUNTRIES, DEFAULT_PASSPORT, STATUS_LABEL, STATUS_FILL, STATUS_BADGE }}>
  const FILTER_STATUSES = ['visa-free', 'visa-on-arrival', 'eta', 'e-visa', 'visa-required'];

  const nameByCode = new Map(COUNTRIES.map((c) => [c.code, c.name]));

  let currentCode = DEFAULT_PASSPORT;
  const activeFilters = new Set(FILTER_STATUSES);
  let searchTerm = '';
  let statusByCode = {};
  let daysByCode = {};
  const rowCache = new Map();

  function decodeCell(cell) {
    if (cell === '-') return { status: 'home' };
    if (cell === 'F') return { status: 'visa-free' };
    if (cell.slice(0, 2) === 'F:') return { status: 'visa-free', days: Number(cell.slice(2)) };
    if (cell === 'A') return { status: 'visa-on-arrival' };
    if (cell === 'E') return { status: 'eta' };
    if (cell === 'V') return { status: 'e-visa' };
    if (cell === 'R') return { status: 'visa-required' };
    if (cell === 'N') return { status: 'no-admission' };
    return { status: 'unknown' };
  }

  const passportSelect = document.getElementById('passportSelect');
  const searchInput = document.getElementById('searchInput');
  const quickPicks = document.getElementById('quickPicks');
  const filterRow = document.getElementById('filterRow');
  const passportNameLabel = document.getElementById('passportNameLabel');
  const matchCount = document.getElementById('matchCount');
  const stackbar = document.getElementById('stackbar');
  const countBadges = document.getElementById('countBadges');
  const resultsList = document.getElementById('resultsList');
  const emptyState = document.getElementById('emptyState');
  const worldMap = document.getElementById('worldMap');
  const tooltip = document.getElementById('mapTooltip');
  const loading = document.getElementById('loading');

  const esc = (s) =>
    String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

  const QP_ON = 'border-brand-700 bg-brand-700 text-slate-50';
  const QP_OFF = 'border-slate-200 bg-white text-slate-700';
  const CHIP_ON = 'border-brand-700 bg-brand-50 text-brand-700';
  const CHIP_OFF = 'border-slate-200 bg-white text-slate-500';

  function setToggle(el, active, on, off) {
    on.split(' ').forEach((c) => el.classList.toggle(c, active));
    off.split(' ').forEach((c) => el.classList.toggle(c, !active));
  }

  function setPassport(code) {
    if (!code) return;
    currentCode = code;
    passportSelect.value = code;
    document.querySelectorAll('.qp').forEach((b) => {
      const active = b.dataset.code === code;
      setToggle(b, active, QP_ON, QP_OFF);
      b.setAttribute('aria-pressed', String(active));
    });
    load(code);
  }

  async function load(code) {
    if (rowCache.has(code)) {
      apply(rowCache.get(code));
      return;
    }
    loading.hidden = false;
    try {
      const res = await fetch(`/api/visa-matrix?passport=${encodeURIComponent(code)}`);
      const json = await res.json();
      const cells = json.cells ?? {};
      rowCache.set(code, cells);
      if (code === currentCode) apply(cells);
    } catch {
      if (code === currentCode) apply({});
    } finally {
      if (code === currentCode) loading.hidden = true;
    }
  }

  function apply(cells) {
    statusByCode = {};
    daysByCode = {};
    for (const [dest, cell] of Object.entries(cells)) {
      const decoded = decodeCell(cell);
      statusByCode[dest] = decoded.status;
      if (decoded.days != null) daysByCode[dest] = decoded.days;
    }
    render();
  }

  function render() {
    passportNameLabel.textContent = nameByCode.get(currentCode) ?? currentCode;

    const counts = {};
    FILTER_STATUSES.forEach((s) => (counts[s] = 0));
    let total = 0;
    for (const [, status] of Object.entries(statusByCode)) {
      if (status === 'home') continue;
      total++;
      if (counts[status] !== undefined) counts[status]++;
    }

    const visibleTotal = FILTER_STATUSES.filter((s) => activeFilters.has(s)).reduce((a, s) => a + counts[s], 0);
    matchCount.textContent = String(visibleTotal);

    stackbar.innerHTML = FILTER_STATUSES.filter((s) => activeFilters.has(s))
      .map(
        (s) =>
          `<div style="height:100%;width:${total ? (counts[s] / total) * 100 : 0}%;background:${STATUS_FILL[s]}"></div>`,
      )
      .join('');

    countBadges.innerHTML = FILTER_STATUSES.map(
      (s) =>
        `<div class="rounded-xl bg-white p-4 text-center shadow-md shadow-black/5" style="border-top:3px solid ${STATUS_FILL[s]}">
          <p class="text-2xl font-bold text-slate-900">${counts[s]}</p>
          <p class="text-xs font-medium text-slate-500">${esc(STATUS_LABEL[s])}</p>
        </div>`,
    ).join('');
    document.querySelectorAll('.country-path').forEach((path) => {
      const alpha2 = path.dataset.alpha2;
      if (!alpha2) return;
      if (alpha2 === currentCode) {
        path.style.fill = STATUS_FILL.home;
        path.classList.remove('opacity-20');
        return;
      }
      const status = statusByCode[alpha2];
      const isVisible = status ? activeFilters.has(status) : false;
      path.style.fill = status ? STATUS_FILL[status] ?? STATUS_FILL.unknown : STATUS_FILL.unknown;
      path.classList.toggle('opacity-20', !isVisible);
    });

    const q = searchTerm.trim().toLowerCase();

    const grouped = {};
    FILTER_STATUSES.forEach((s) => (grouped[s] = []));
    for (const [dest, status] of Object.entries(statusByCode)) {
      if (status === 'home') continue;
      if (!activeFilters.has(status)) continue;
      if (q && !(nameByCode.get(dest) ?? dest).toLowerCase().includes(q)) continue;
      if (grouped[status]) grouped[status].push(dest);
    }

    const card = (dest, status) => {
      const name = nameByCode.get(dest) ?? dest;
      const days = daysByCode[dest];
      const label = days != null ? `${STATUS_LABEL[status]} · ${days} days` : STATUS_LABEL[status];
      return `<li class="flex items-center justify-between gap-2 rounded-lg bg-white px-3 py-2 text-sm shadow-sm" style="border-left:3px solid ${STATUS_FILL[status]}">
        <span><span class="font-medium text-slate-900">${esc(name)}</span><span class="ml-1.5 font-mono text-xs text-slate-400">${esc(dest)}</span></span>
        <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium ${STATUS_BADGE[status]}">${esc(label)}</span>
      </li>`;
    };

    const sections = FILTER_STATUSES
      .filter((s) => grouped[s].length > 0)
      .map((s) => {
        const items = grouped[s].sort((a, b) => (nameByCode.get(a) ?? a).localeCompare(nameByCode.get(b) ?? b));
        return `<section>
          <h3 class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-slate-500">
            ${esc(STATUS_LABEL[s])}
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500">${items.length}</span>
          </h3>
          <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            ${items.map((dest) => card(dest, s)).join('')}
          </ul>
        </section>`;
      })
      .join('');

    if (sections === '') {
      resultsList.innerHTML = '';
      emptyState.hidden = false;
    } else {
      emptyState.hidden = true;
      resultsList.innerHTML = sections;
    }
  }

  passportSelect.addEventListener('change', (e) => setPassport(e.target.value));
  searchInput.addEventListener('input', (e) => {
    searchTerm = e.target.value;
    render();
  });

  quickPicks.addEventListener('click', (e) => {
    const btn = e.target.closest('.qp');
    if (btn && btn.dataset.code) setPassport(btn.dataset.code);
  });

  filterRow.addEventListener('click', (e) => {
    const chip = e.target.closest('.filter-chip');
    const status = chip && chip.dataset.status;
    if (!chip || !status) return;
    const active = !activeFilters.has(status);
    if (active) activeFilters.add(status);
    else activeFilters.delete(status);
    setToggle(chip, active, CHIP_ON, CHIP_OFF);
    chip.setAttribute('aria-pressed', String(active));
    render();
  });

  worldMap.addEventListener('mousemove', (e) => {
    const path = e.target.closest('.country-path');
    if (!path || !path.dataset.alpha2) {
      tooltip.hidden = true;
      return;
    }
    const status = statusByCode[path.dataset.alpha2];
    const days = daysByCode[path.dataset.alpha2];
    const label = status ? STATUS_LABEL[status] : 'Unknown';
    tooltip.textContent = `${path.dataset.name} ${label}${days != null ? ` · ${days} days` : ''}`;
    tooltip.style.left = `${e.clientX + 14}px`;
    tooltip.style.top = `${e.clientY + 14}px`;
    tooltip.hidden = false;
  });
  worldMap.addEventListener('mouseleave', () => {
    tooltip.hidden = true;
  });

  setPassport(DEFAULT_PASSPORT);
  </script>
</BaseLayout>
