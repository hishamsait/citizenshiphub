---
import BaseLayout from '../layouts/BaseLayout.astro';
import VisaExplorer from '../components/VisaExplorer';
import { getWorldPaths } from '../lib/map';
import { getDb } from '../lib/db/client';
import { listCountries } from '../lib/db/countries';

const db = getDb(Astro.locals);
const countries = (await listCountries(db)).map((c) => ({ code: c.code, name: c.name, region: c.region }));
const initialPassport = Astro.url.searchParams.get('passport') ?? '';
const paths = getWorldPaths();
---

<BaseLayout
  title="Visa Explorer"
  description="See where any passport can travel visa-free, visa on arrival, ETA, or e-visa — browse every destination by access status."
>
  <section>
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Visa explorer</h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        Pick a passport and browse every destination by access status — visa-free, visa on arrival, ETA, e-visa, or visa
        required.
      </p>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <VisaExplorer client:load countries={countries} paths={paths} initialPassport={initialPassport} />
  </section>
</BaseLayout>
