---
import BaseLayout from '../layouts/BaseLayout.astro';
import VisaExplorer from '../components/VisaExplorer';
import matrixData from '../data/visa-matrix.json';
import passportsData from '../data/passports.json';
import { getWorldPaths } from '../lib/map';
import type { VisaMatrix, PassportsData } from '../data/types';

export const prerender = true;

const { matrix } = matrixData as unknown as VisaMatrix;
const { passports } = passportsData as unknown as PassportsData;
const countries = passports.map((p) => ({ code: p.code, name: p.name, region: p.region }));
const initialPassport = Astro.url.searchParams.get('passport') ?? '';
const paths = getWorldPaths();
---

<BaseLayout
  title="Visa Explorer"
  description="See where any passport can travel visa-free, visa on arrival, ETA, or e-visa — browse every destination by access status."
>
  <section>
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Visa explorer</h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        Pick a passport and browse every destination by access status — visa-free, visa on arrival, ETA, e-visa, or visa
        required.
      </p>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <VisaExplorer client:load matrix={matrix} countries={countries} paths={paths} initialPassport={initialPassport} />
  </section>
</BaseLayout>
