---
import BaseLayout from '../layouts/BaseLayout.astro';
import PassportRankTable from '../components/PassportRankTable';
import type { TableRow } from '../components/PassportRankTable';
import { getDb } from '../lib/db/client';
import { listRankings } from '../lib/db/rankings';
import { listEconomics } from '../lib/db/economics';
import { listFreedom } from '../lib/db/freedom';
import { listCitizenshipLaws } from '../lib/db/citizenship';
import { listTax } from '../lib/db/tax';
import { listGuides } from '../lib/db/guides';
import { getDatasetMeta } from '../lib/db/meta';
import { scoreAcquisition } from '../lib/acquire';
import { scoreEconomy, scoreFreedom, scoreTax } from '../lib/scores';

const db = getDb(Astro.locals);

const [rankings, economics, freedom, laws, tax, guides, meta] = await Promise.all([
  listRankings(db),
  listEconomics(db),
  listFreedom(db),
  listCitizenshipLaws(db),
  listTax(db),
  listGuides(db),
  getDatasetMeta(db, 'rankings'),
]);

const guideSlugs = new Map(guides.map((g) => [g.iso2.toUpperCase(), g.slug]));
const lawByCode = new Map(laws.map((l) => [l.iso2, l]));

const rows: TableRow[] = rankings.map((r) => {
  const code = r.code;
  const econ = economics[code];
  const free = freedom[code];
  const law = lawByCode.get(code);
  const t = tax[code];
  return {
    code,
    name: r.name,
    rank: r.rank,
    flag: r.flag ?? null,
    region: r.region,
    subregion: r.subregion ?? '',
    continent: r.continent ?? null,
    visaFree: r.visaFree,
    visaOnArrival: r.visaOnArrival,
    eta: r.eta,
    eVisa: r.eVisa,
    visaRequired: r.visaRequired,
    mobilityScore: r.mobilityScore,
    population: r.population ?? null,
    areaKm2: r.areaKm2 ?? null,
    incomeGroup: r.incomeGroup ?? null,
    gdpPerCapitaUsd: econ?.gdpPerCapitaUsd ?? null,
    inflationPct: econ?.inflationPct ?? null,
    hdi: econ?.hdi ?? null,
    lifeExpectancy: econ?.lifeExpectancy ?? null,
    gdpGrowthPct: econ?.gdpGrowthPct ?? null,
    cpiScore: free?.cpi?.score ?? null,
    fiwScore: free?.fiw?.score ?? null,
    humanRightsScore: free?.humanRights?.score ?? null,
    democracyScore: free?.democracy?.score ?? null,
    happinessScore: free?.happiness?.score ?? null,
    citizenshipByDescent: law?.citizenshipByDescent ?? false,
    naturalizationYears: law?.naturalizationYears ?? null,
    dualCitizenshipAllowed: law?.dualCitizenshipAllowed ?? false,
    cbi: law?.cbi ?? false,
    goldenVisa: law?.goldenVisa ?? false,
    birthright: law?.birthright ?? false,
    digitalNomadVisa: law?.digitalNomadVisa ?? false,
    personalIncomeTax: t?.personalIncomeTax ?? null,
    corporateTax: t?.corporateTax ?? null,
    vat: t?.vat ?? null,
    territorial: t?.territorial ?? null,
    wealth: t?.wealth ?? null,
    nonDom: t?.nonDom ?? null,
    easeScore: law ? scoreAcquisition(law).score : null,
    freedomScore: free ? scoreFreedom(free) : null,
    economyScore: econ ? scoreEconomy(econ) : null,
    taxScore: t ? scoreTax(t) : null,
    guideSlug: guideSlugs.get(code),
  };
});

const q = Astro.url.searchParams.get('q') ?? '';
const totalCountries = meta?.totalCountries ?? rankings.length;
const asOf = meta?.generatedAt
  ? new Date(meta.generatedAt).toLocaleDateString('en-GB', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : 'recently';
---

<BaseLayout
  title="Passport Rankings"
  description={`Compare the mobility of ${totalCountries} passports by visa-free, visa-on-arrival, ETA, and e-visa access.`}
>
  <section>
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
      <nav class="mb-4 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="transition hover:text-slate-900">Home</a>
        <span aria-hidden="true" class="mx-1.5 text-slate-300">·</span>
        <span class="text-slate-700">Rankings</span>
      </nav>
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Global passport rankings</h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        A passport's mobility score counts the destinations you can enter without a traditional visa visa-free, visa
        on arrival, ETA, and e-visa. Data covers {totalCountries} countries, last refreshed {asOf}.
      </p>
      <p class="mt-2 text-sm text-slate-400">
        Rank by mobility, freedom, economy, tax, or ease of acquisition · search · filter · toggle columns · sort any column.
      </p>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <PassportRankTable client:load rows={rows} initialQuery={q} totalCountries={totalCountries} />
  </section>
</BaseLayout>
