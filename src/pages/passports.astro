---
import BaseLayout from '../layouts/BaseLayout.astro';
import PassportRankTable from '../components/PassportRankTable';
import type { TableRow } from '../components/PassportRankTable';
import { getCollection } from 'astro:content';
import rankingsData from '../data/rankings.json';
import type { RankingsData } from '../data/types';

export const prerender = true;

const { rankings, meta } = rankingsData as unknown as RankingsData;

const guides = await getCollection('countries');
const guideSlugs = new Map(guides.map((g) => [g.data.iso2.toUpperCase(), g.id]));

const rows: TableRow[] = rankings.map((r) => ({
  code: r.code,
  name: r.name,
  region: r.region,
  subregion: r.subregion ?? '',
  capital: r.capital ?? '',
  visaFree: r.visaFree,
  visaOnArrival: r.visaOnArrival,
  eta: r.eta,
  eVisa: r.eVisa,
  mobilityScore: r.mobilityScore,
  rank: r.rank,
  guideSlug: guideSlugs.get(r.code),
}));

const q = Astro.url.searchParams.get('q') ?? '';
const asOf = meta.generatedAt
  ? new Date(meta.generatedAt).toLocaleDateString('en-GB', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : 'recently';
---

<BaseLayout
  title="Passport Rankings"
  description={`Compare the mobility of ${meta.totalCountries} passports by visa-free, visa-on-arrival, ETA, and e-visa access.`}
>
  <section>
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Global passport rankings</h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        A passport's mobility score counts the destinations you can enter without a traditional visa — visa-free, visa
        on arrival, ETA, and e-visa. Data covers {meta.totalCountries} countries, last refreshed {asOf}.
      </p>
      <p class="mt-2 text-sm text-slate-400">Search by country, code, or capital · filter by region · sort any column.</p>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <PassportRankTable client:load rows={rows} initialQuery={q} totalCountries={meta.totalCountries} />
  </section>
</BaseLayout>
