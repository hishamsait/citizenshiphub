---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugify } from '../../lib/utils';
import { getDb } from '../../lib/db/client';
import { listCountries } from '../../lib/db/countries';

const db = getDb(Astro.locals);
const passports = await listCountries(db);

const byRegion = new Map<string, typeof passports>();
for (const p of passports) {
  const list = byRegion.get(p.region) ?? [];
  list.push(p);
  byRegion.set(p.region, list);
}
for (const list of byRegion.values()) list.sort((a, b) => a.name.localeCompare(b.name));
const regions = [...byRegion.keys()].sort();
---

<BaseLayout
  title="Destinations"
  description="Browse every destination and see which passports can enter visa-free, visa on arrival, ETA, or e-visa."
>
  <section>
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Destinations</h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        Pick a destination to see which passports can visit it — and under what conditions.
      </p>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    {
      regions.map((region) => (
        <div class="mb-8">
          <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">{region}</h2>
          <ul class="grid gap-1.5 sm:grid-cols-2 lg:grid-cols-3">
            {
              (byRegion.get(region) ?? []).map((p) => (
                <li>
                  <a
                    href={`/destinations/${slugify(p.name)}/`}
                    class="flex items-center justify-between rounded-lg bg-white px-3 py-2 text-sm text-slate-700 shadow-sm hover:bg-brand-50"
                  >
                    <span>{p.name}</span>
                    <span class="font-mono text-xs text-slate-400">{p.code}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>
