---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { decodeCell, STATUS_LABEL, type AccessStatus } from '../../lib/visa';
import { slugify } from '../../lib/utils';
import matrixData from '../../data/visa-matrix.json';
import passportsData from '../../data/passports.json';
import type { VisaMatrix, PassportsData } from '../../data/types';

const GROUPS: AccessStatus[] = ['visa-free', 'visa-on-arrival', 'eta', 'e-visa'];

export async function getStaticPaths() {
  const { matrix } = matrixData as unknown as VisaMatrix;
  const { passports } = passportsData as unknown as PassportsData;
  return passports.map((dest) => {
    const groups: Record<string, { code: string; name: string }[]> = {
      'visa-free': [],
      'visa-on-arrival': [],
      eta: [],
      'e-visa': [],
      'visa-required': [],
    };
    for (const p of passports) {
      const status = decodeCell(matrix[p.code]?.[dest.code] ?? '?').status;
      const bucket = groups[status];
      if (bucket) bucket.push({ code: p.code, name: p.name });
    }
    return { params: { slug: slugify(dest.name) }, props: { dest, groups, total: passports.length } };
  });
}

const { dest, groups, total } = Astro.props;
const accessible = GROUPS.reduce((n, s) => n + (groups[s] ?? []).length, 0);
const required = (groups['visa-required'] ?? []).length;
---

<BaseLayout
  title={`Who can visit ${dest.name}?`}
  description={`Visa requirements for ${dest.name} — see which passports can enter visa-free, visa on arrival, ETA, or e-visa.`}
  canonical={Astro.url.pathname}
>
  <section>
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-700">
        {dest.region} · {dest.code}
      </p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
        Who can visit {dest.name}?
      </h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        {accessible} of {total} passports can enter {dest.name} visa-free, visa on arrival, by ETA, or with an
        e-visa.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <div class="space-y-8">
      {
        GROUPS.map((s) => {
          const items = groups[s] ?? [];
          if (items.length === 0) return null;
          return (
            <div>
              <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-slate-500">
                {STATUS_LABEL[s]}
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500">
                  {items.length}
                </span>
              </h2>
              <ul class="flex flex-wrap gap-1.5">
                {
                  items.map((p) => (
                    <li>
                      <a
                        href={`/countries/${slugify(p.name)}/`}
                        class="inline-flex items-center rounded-full bg-white px-3 py-1 text-sm text-slate-700 shadow-sm hover:bg-brand-50"
                      >
                        {p.name}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          );
        })
      }
      <p class="text-sm text-slate-500">{required} passports require a visa to visit {dest.name}.</p>
    </div>
  </section>
</BaseLayout>
