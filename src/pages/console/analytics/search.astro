---
import ConsoleLayout from '../../../layouts/ConsoleLayout.astro';
import StatCard from '../../../components/console/StatCard.astro';
import TimeRangePicker from '../../../components/console/TimeRangePicker.astro';
import { getDb } from '../../../lib/db/client';
import { createAnalyticsProvider } from '../../../lib/analytics/first-party';
import { resolveRange } from '../../../lib/analytics/types';
import { formatNumber } from '../../../lib/utils';
import { Search, FileWarning } from 'lucide-react';

const db = getDb(Astro.locals);
const range = resolveRange(Astro.url.searchParams.get('range'));
const data = await createAnalyticsProvider(Astro.locals.runtime.env).search(db, range);

const fmt = (n: number) => formatNumber(n);
---

<ConsoleLayout
  title="Analytics Search"
  description="On-site search queries and zero-result searches."
>
  <div class="flex items-center justify-between gap-3">
    <p class="text-sm text-slate-500">Showing the last {range.days} days</p>
    <TimeRangePicker />
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    <StatCard label="Searches" value={fmt(data.total)} icon={Search} hint="On-site queries" />
    <StatCard label="No results" value={fmt(data.noResults)} icon={FileWarning} hint="Queries with 0 matches" />
    <StatCard
      label="No-result rate"
      value={data.noResultRate == null ? '—' : `${data.noResultRate.toFixed(1)}%`}
      icon={Search}
      hint="Of all searches"
    />
  </div>

  <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    {
      data.queries.length === 0 ? (
        <p class="py-12 text-center text-sm text-slate-400">No searches recorded yet.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-100 bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-400">
                <th class="px-5 py-3 font-medium">Query</th>
                <th class="px-5 py-3 text-right font-medium">Searches</th>
                <th class="px-5 py-3 text-right font-medium">No results</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {
                data.queries.map((q) => (
                  <tr class="hover:bg-slate-50">
                    <td class="px-5 py-3 text-slate-700">“{q.query}”</td>
                    <td class="px-5 py-3 text-right tabular-nums text-slate-900">{fmt(q.count)}</td>
                    <td class="px-5 py-3 text-right tabular-nums text-slate-500">{fmt(q.noResults)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</ConsoleLayout>
