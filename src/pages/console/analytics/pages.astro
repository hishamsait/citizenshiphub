---
import ConsoleLayout from '../../../layouts/ConsoleLayout.astro';
import TimeRangePicker from '../../../components/console/TimeRangePicker.astro';
import { getDb } from '../../../lib/db/client';
import { createAnalyticsProvider } from '../../../lib/analytics/first-party';
import { resolveRange } from '../../../lib/analytics/types';
import { formatNumber } from '../../../lib/utils';

const db = getDb(Astro.locals);
const range = resolveRange(Astro.url.searchParams.get('range'));
const data = await createAnalyticsProvider(Astro.locals.runtime.env).pages(db, range);
const fmt = (n: number) => formatNumber(n);
---

<ConsoleLayout
  title="Analytics Pages"
  description="Page-by-page traffic for the last period."
>
  <div class="flex items-center justify-between gap-3">
    <p class="text-sm text-slate-500">
      {fmt(data.total)} pageviews across {data.rows.length} paths
    </p>
    <TimeRangePicker />
  </div>

  <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    {
      data.rows.length === 0 ? (
        <p class="py-12 text-center text-sm text-slate-400">No pageviews recorded yet.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-100 bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-400">
                <th class="px-5 py-3 font-medium">Path</th>
                <th class="px-5 py-3 text-right font-medium">Views</th>
                <th class="px-5 py-3 text-right font-medium">Unique</th>
                <th class="px-5 py-3 text-right font-medium">Share</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {
                data.rows.map((r) => (
                  <tr class="hover:bg-slate-50">
                    <td class="px-5 py-3">
                      <a href={r.path} class="text-slate-700 hover:text-brand-700">
                        {r.path}
                      </a>
                    </td>
                    <td class="px-5 py-3 text-right tabular-nums text-slate-900">{fmt(r.views)}</td>
                    <td class="px-5 py-3 text-right tabular-nums text-slate-500">{fmt(r.uniques)}</td>
                    <td class="px-5 py-3 text-right tabular-nums text-slate-500">
                      {r.share.toFixed(1)}%
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</ConsoleLayout>
