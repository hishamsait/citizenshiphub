---
import ConsoleLayout from '../../../layouts/ConsoleLayout.astro';
import TimeRangePicker from '../../../components/console/TimeRangePicker.astro';
import { getDb } from '../../../lib/db/client';
import { createAnalyticsProvider } from '../../../lib/analytics/first-party';
import { resolveRange } from '../../../lib/analytics/types';
import { formatNumber } from '../../../lib/utils';
import { TrendingUp, Users } from 'lucide-react';

const db = getDb(Astro.locals);
const range = resolveRange(Astro.url.searchParams.get('range'));
const data = await createAnalyticsProvider(Astro.locals.runtime.env).funnel(db, range);

const fmt = (n: number) => formatNumber(n);
const maxCount = Math.max(1, ...data.stages.map((s) => s.count));
---

<ConsoleLayout
  title="Analytics Funnel"
  description="Lead modal open → submit → captured conversion."
>
  <div class="flex items-center justify-between gap-3">
    <p class="text-sm text-slate-500">Showing the last {range.days} days</p>
    <TimeRangePicker />
  </div>

  <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-3 flex items-center gap-2">
      <TrendingUp className="h-4 w-4 text-slate-400" aria-hidden="true" />
      <h2 class="text-sm font-semibold text-slate-900">Conversion funnel</h2>
    </div>
    <ul class="space-y-3">
      {
        data.stages.map((s) => (
          <li>
            <div class="flex items-center justify-between text-sm">
              <span class="text-slate-700">{s.label}</span>
              <span class="tabular-nums text-slate-400">{fmt(s.count)}</span>
            </div>
            <div class="mt-1 h-2 overflow-hidden rounded-full bg-slate-100">
              <div
                class="h-2 rounded-full bg-brand-700"
                style={`width:${((s.count / maxCount) * 100).toFixed(1)}%`}
              ></div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mt-6 grid gap-6 sm:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="mb-2 flex items-center gap-2">
        <Users className="h-4 w-4 text-slate-400" aria-hidden="true" />
        <h2 class="text-sm font-semibold text-slate-900">Open → submit</h2>
      </div>
      <p class="text-3xl font-bold tabular-nums text-slate-900">
        {data.openToSubmitRate == null ? '—' : `${data.openToSubmitRate.toFixed(1)}%`}
      </p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="mb-2 flex items-center gap-2">
        <Users className="h-4 w-4 text-slate-400" aria-hidden="true" />
        <h2 class="text-sm font-semibold text-slate-900">Submit → captured</h2>
      </div>
      <p class="text-3xl font-bold tabular-nums text-slate-900">
        {data.submitToCaptureRate == null ? '—' : `${data.submitToCaptureRate.toFixed(1)}%`}
      </p>
    </div>
  </div>
</ConsoleLayout>
