---
import ConsoleLayout from '../../../layouts/ConsoleLayout.astro';
import TimeRangePicker from '../../../components/console/TimeRangePicker.astro';
import { getDb } from '../../../lib/db/client';
import { createAnalyticsProvider } from '../../../lib/analytics/first-party';
import { resolveRange } from '../../../lib/analytics/types';
import { formatNumber } from '../../../lib/utils';
import { Gauge, Zap, Activity } from 'lucide-react';

const db = getDb(Astro.locals);
const range = resolveRange(Astro.url.searchParams.get('range'));
const data = await createAnalyticsProvider(Astro.locals.runtime.env).performance(db, range);

function band(metric: string, value: number | null) {
  if (value == null) return { label: 'No data', cls: 'bg-slate-100 text-slate-500' };
  const bounds: Record<string, [number, number]> = {
    LCP: [2500, 4000],
    CLS: [0.1, 0.25],
    INP: [200, 500],
    TTFB: [800, 1800],
    FCP: [1800, 3000],
  };
  const [good, needs] = bounds[metric] ?? [0, 0];
  if (value <= good) return { label: 'Good', cls: 'bg-emerald-50 text-emerald-700' };
  if (value <= needs) return { label: 'Needs improvement', cls: 'bg-amber-50 text-amber-700' };
  return { label: 'Poor', cls: 'bg-red-50 text-red-700' };
}

function display(metric: string, value: number | null): string {
  if (value == null) return '—';
  return metric === 'CLS' ? value.toFixed(3) : `${Math.round(value)} ms`;
}

const labels: Record<string, string> = {
  LCP: 'Largest Contentful Paint',
  CLS: 'Cumulative Layout Shift',
  INP: 'Interaction to Next Paint',
  TTFB: 'Time to First Byte',
  FCP: 'First Contentful Paint',
};

const fmt = (n: number) => formatNumber(n);
const cacheRatio = data.cache.requests > 0 ? (data.cache.cachedRequests / data.cache.requests) * 100 : null;
const mb = (b: number) => (b / 1048576).toFixed(1) + ' MB';
---

<ConsoleLayout
  title="Analytics Performance"
  description="Real-user Core Web Vitals (75th percentile) from Cloudflare Web Analytics."
>
  <div class="flex items-center justify-between gap-3">
    <p class="text-sm text-slate-500">Samples from the last {range.days} days</p>
    <TimeRangePicker />
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
    {
      data.metrics.map((m) => {
        const b = band(m.metric, m.p75);
        return (
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <Gauge className="h-4 w-4 text-slate-400" aria-hidden="true" />
                <span class="text-sm font-semibold text-slate-900">{m.metric}</span>
              </div>
              <span class:list={['rounded-full px-2 py-0.5 text-xs font-semibold', b.cls]}>{b.label}</span>
            </div>
            <p class="mt-3 text-2xl font-bold tabular-nums text-slate-900">{display(m.metric, m.p75)}</p>
            <p class="mt-1 text-xs text-slate-400">{labels[m.metric] ?? m.metric}</p>
            <p class="mt-2 text-xs text-slate-400">{m.samples} sample{m.samples === 1 ? '' : 's'}</p>
          </div>
        );
      })
    }
  </div>

  <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="mb-3 text-sm font-semibold text-slate-900">Web vitals by device</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-100 text-left text-xs uppercase tracking-wide text-slate-400">
            <th class="pb-2 font-medium">Device</th>
            {['LCP', 'CLS', 'INP', 'TTFB', 'FCP'].map((m) => <th class="pb-2 text-right font-medium">{m}</th>)}
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {
            data.byDevice.map((d) => (
              <tr>
                <td class="py-2.5 pr-3 font-medium capitalize text-slate-700">{d.device}</td>
                {d.metrics.map((m) => (
                  <td class="py-2.5 text-right tabular-nums text-slate-500">
                    {m.p75 == null ? '—' : display(m.metric, m.p75)}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="mb-3 flex items-center gap-2">
        <Zap className="h-4 w-4 text-slate-400" aria-hidden="true" />
        <h2 class="text-sm font-semibold text-slate-900">Cache & bandwidth</h2>
      </div>
      <dl class="space-y-2 text-sm">
        <div class="flex justify-between">
          <dt class="text-slate-500">Data served</dt>
          <dd class="tabular-nums text-slate-900">{mb(data.cache.bytes)}</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-slate-500">Cached requests</dt>
          <dd class="tabular-nums text-slate-900">{fmt(data.cache.cachedRequests)}</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-slate-500">Cached bandwidth</dt>
          <dd class="tabular-nums text-slate-900">{mb(data.cache.cachedBytes)}</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-slate-500">Cache hit ratio</dt>
          <dd class="tabular-nums text-slate-900">{cacheRatio == null ? '—' : `${cacheRatio.toFixed(1)}%`}</dd>
        </div>
      </dl>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="mb-3 flex items-center gap-2">
        <Activity className="h-4 w-4 text-slate-400" aria-hidden="true" />
        <h2 class="text-sm font-semibold text-slate-900">Response status codes</h2>
      </div>
      {
        data.statusCodes.length === 0 ? (
          <p class="py-4 text-center text-sm text-slate-400">No data yet.</p>
        ) : (
          <ul class="space-y-2">
            {
              data.statusCodes.map((s) => (
                <li class="flex items-center justify-between text-sm">
                  <span class="text-slate-700">{s.status}</span>
                  <span class="tabular-nums text-slate-400">{fmt(s.views)}</span>
                </li>
              ))
            }
          </ul>
        )
      }
    </div>
  </div>

  <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 text-sm text-slate-500 shadow-sm">
    <p>
      These figures come from <strong class="text-slate-700">Cloudflare Web Analytics</strong> and represent the
      <strong class="text-slate-700"> 75th percentile</strong> across real visitors in the selected window. If the
      cards are empty, enable Web Analytics on the zone and set <code class="text-xs">CF_ANALYTICS_API_TOKEN</code>{' '}
      / <code class="text-xs">CF_ZONE_ID</code>.
    </p>
  </div>
</ConsoleLayout>
