---
import ConsoleLayout from '../../../layouts/ConsoleLayout.astro';
import TimeRangePicker from '../../../components/console/TimeRangePicker.astro';
import { getDb } from '../../../lib/db/client';
import { generateAiInsights, type Insight } from '../../../lib/analytics/insights';
import { resolveRange } from '../../../lib/analytics/types';
import { formatDateTime } from '../../../lib/utils';
import { Eye, Users, FileText, Gauge, Sparkles, RefreshCw } from 'lucide-react';

const db = getDb(Astro.locals);
const range = resolveRange(Astro.url.searchParams.get('range'));

let insights: Insight[] | null = null;
let generatedAt: string | null = null;
let effectiveDays = range.days;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const posted = resolveRange(String(formData.get('range') ?? '') || undefined);
  effectiveDays = posted.days;
  insights = await generateAiInsights(Astro.locals.runtime.env, db, posted.days);
  generatedAt = new Date().toISOString();
}

const toneAccent: Record<string, string> = {
  positive: 'border-l-emerald-400',
  neutral: 'border-l-slate-300',
  negative: 'border-l-red-400',
};

const categoryIcon: Record<string, unknown> = {
  traffic: Eye,
  leads: Users,
  content: FileText,
  performance: Gauge,
};
---

<ConsoleLayout
  title="Analytics AI Insights"
  description="Generate AI-powered observations from your current analytics."
>
  <div class="flex items-center justify-between gap-3">
    <p class="text-sm text-slate-500">Analyzing the last {effectiveDays} days</p>
    <TimeRangePicker />
  </div>

  <form method="POST" class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <input type="hidden" name="range" value={range.key} />
    <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="flex items-center gap-2">
          <Sparkles className="h-4 w-4 text-gold-500" aria-hidden="true" />
          <h2 class="text-sm font-semibold text-slate-900">
            {insights == null ? 'Ready to analyze' : 'Insights generated'}
          </h2>
        </div>
        <p class="mt-1 text-sm text-slate-500">
          {
            insights == null
              ? `Generate AI insights from the last ${effectiveDays} days of traffic, leads and content.`
              : `Generated ${generatedAt ? formatDateTime(generatedAt) : 'just now'} · ${insights.length} insight${insights.length === 1 ? '' : 's'}`
          }
        </p>
      </div>
      <button
        type="submit"
        class="inline-flex items-center gap-2 rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-slate-50 transition hover:bg-brand-800"
      >
        {insights == null ? <Sparkles className="h-4 w-4" aria-hidden="true" /> : <RefreshCw className="h-4 w-4" aria-hidden="true" />}
        {insights == null ? 'Generate insights' : 'Regenerate'}
      </button>
    </div>
  </form>

  {
    insights == null ? (
      <div class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-12 text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-white shadow-sm">
          <Sparkles className="h-6 w-6 text-slate-300" aria-hidden="true" />
        </div>
        <p class="mt-4 text-sm font-medium text-slate-500">No insights yet</p>
        <p class="mt-1 text-sm text-slate-400">Click “Generate insights” to analyze the current analytics.</p>
      </div>
    ) : (
      <div class="mt-6 grid gap-4 lg:grid-cols-2">
        {
          insights.map((ins) => {
            const Icon = (categoryIcon[ins.category] as typeof Eye) ?? Sparkles;
            return (
              <div
                class:list={[
                  'rounded-2xl border border-slate-200 border-l-4 bg-white p-5 shadow-sm',
                  toneAccent[ins.tone] ?? toneAccent.neutral,
                ]}
              >
                <div class="flex items-center gap-2">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-slate-100 text-slate-500">
                    <Icon className="h-4 w-4" aria-hidden="true" />
                  </span>
                  <span class="text-xs font-semibold uppercase tracking-wide text-slate-400">{ins.category}</span>
                </div>
                <h2 class="mt-3 text-base font-semibold text-slate-900">{ins.title}</h2>
                <p class="mt-1 text-sm leading-relaxed text-slate-500">{ins.body}</p>
              </div>
            );
          })
        }
      </div>
    )
  }
</ConsoleLayout>
