---
import ConsoleLayout from '../../../layouts/ConsoleLayout.astro';
import StatCard from '../../../components/console/StatCard.astro';
import Sparkline from '../../../components/console/Sparkline.astro';
import TimeRangePicker from '../../../components/console/TimeRangePicker.astro';
import { getDb } from '../../../lib/db/client';
import { firstPartyProvider } from '../../../lib/analytics/first-party';
import { resolveRange } from '../../../lib/analytics/types';
import { formatNumber } from '../../../lib/utils';
import { Users, Eye, MousePointerClick, TrendingUp, Globe, Monitor, Gauge, Files, RefreshCw } from 'lucide-react';

const db = getDb(Astro.locals);
const range = resolveRange(Astro.url.searchParams.get('range'));
const data = await firstPartyProvider.overview(db, range);

const fmt = (n: number) => formatNumber(n);
const maxCountry = Math.max(1, ...data.topCountries.map((c) => c.views));
const maxDevice = Math.max(1, ...data.devices.map((d) => d.views));
---

<ConsoleLayout
  title="Analytics Overview"
  description="Traffic, engagement and conversion across the whole site."
>
  <div class="flex items-center justify-between gap-3">
    <p class="text-sm text-slate-500">Showing the last {range.days} days</p>
    <TimeRangePicker />
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <StatCard label="Visitors" value={fmt(data.visitors)} icon={Users} hint="Unique sessions" />
    <StatCard label="Pageviews" value={fmt(data.pageviews)} icon={Eye} hint="All page loads" />
    <StatCard label="Leads" value={fmt(data.leads)} icon={MousePointerClick} hint="Captured enquiries" />
    <StatCard
      label="Conversion"
      value={data.conversionRate == null ? '—' : `${data.conversionRate.toFixed(1)}%`}
      icon={TrendingUp}
      hint="Leads per visitor"
    />
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    <StatCard
      label="Bounce rate"
      value={data.engagement.bounceRate == null ? '—' : `${data.engagement.bounceRate.toFixed(1)}%`}
      icon={Gauge}
      hint="Single-page sessions"
    />
    <StatCard
      label="Pages / session"
      value={data.engagement.pagesPerSession == null ? '—' : data.engagement.pagesPerSession.toFixed(1)}
      icon={Files}
      hint="Average per visitor"
    />
    <StatCard
      label="Returning visitors"
      value={fmt(data.engagement.returningSessions)}
      icon={RefreshCw}
      hint={`${data.engagement.returningRate == null ? '—' : `${data.engagement.returningRate.toFixed(0)}%`} of sessions`}
    />
  </div>

  <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-slate-900">Pageviews over time</h2>
      <span class="text-xs text-slate-400">{range.label}</span>
    </div>
    <Sparkline points={data.series.map((s) => s.views)} />
  </div>
  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm lg:col-span-2">
      <h2 class="mb-3 text-sm font-semibold text-slate-900">Top pages</h2>
      {
        data.topPages.length === 0 ? (
          <p class="py-6 text-center text-sm text-slate-400">No pageviews recorded yet.</p>
        ) : (
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-100 text-left text-xs uppercase tracking-wide text-slate-400">
                <th class="pb-2 font-medium">Page</th>
                <th class="pb-2 text-right font-medium">Views</th>
                <th class="pb-2 text-right font-medium">Unique</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {
                data.topPages.map((p) => (
                  <tr>
                    <td class="py-2.5 pr-3">
                      <a href={p.path} class="block max-w-xs truncate text-slate-700 hover:text-brand-700">
                        {p.path}
                      </a>
                    </td>
                    <td class="py-2.5 text-right tabular-nums text-slate-900">{fmt(p.views)}</td>
                    <td class="py-2.5 text-right tabular-nums text-slate-500">{fmt(p.uniques)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        )
      }
    </div>

    <div class="space-y-6">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="mb-3 flex items-center gap-2">
          <Globe className="h-4 w-4 text-slate-400" aria-hidden="true" />
          <h2 class="text-sm font-semibold text-slate-900">Top countries</h2>
        </div>
        {
          data.topCountries.length === 0 ? (
            <p class="py-4 text-center text-sm text-slate-400">No data yet.</p>
          ) : (
            <ul class="space-y-2.5">
              {
                data.topCountries.map((c) => (
                  <li>
                    <div class="flex items-center justify-between text-sm">
                      <span class="text-slate-700">{c.country}</span>
                      <span class="tabular-nums text-slate-400">{fmt(c.views)}</span>
                    </div>
                    <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-100">
                      <div
                        class="h-1.5 rounded-full bg-brand-700"
                        style={`width:${((c.views / maxCountry) * 100).toFixed(1)}%`}
                      ></div>
                    </div>
                  </li>
                ))
              }
            </ul>
          )
        }
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="mb-3 flex items-center gap-2">
          <Monitor className="h-4 w-4 text-slate-400" aria-hidden="true" />
          <h2 class="text-sm font-semibold text-slate-900">Devices</h2>
        </div>
        {
          data.devices.length === 0 ? (
            <p class="py-4 text-center text-sm text-slate-400">No data yet.</p>
          ) : (
            <ul class="space-y-2.5">
              {
                data.devices.map((d) => (
                  <li>
                    <div class="flex items-center justify-between text-sm">
                      <span class="capitalize text-slate-700">{d.device}</span>
                      <span class="tabular-nums text-slate-400">{fmt(d.views)}</span>
                    </div>
                    <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-100">
                      <div
                        class="h-1.5 rounded-full bg-gold-500"
                        style={`width:${((d.views / maxDevice) * 100).toFixed(1)}%`}
                      ></div>
                    </div>
                  </li>
                ))
              }
            </ul>
          )
        }
      </div>
    </div>
  </div>

  <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-3 flex items-center gap-2">
      <Globe className="h-4 w-4 text-slate-400" aria-hidden="true" />
      <h2 class="text-sm font-semibold text-slate-900">Traffic sources</h2>
    </div>
    {
      data.sources.length === 0 ? (
        <p class="py-4 text-center text-sm text-slate-400">No data yet.</p>
      ) : (
        <div class="flex flex-wrap gap-2">
          {
            data.sources.map((s) => (
              <span class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-700">
                {s.source} · {fmt(s.views)}
              </span>
            ))
          }
        </div>
      )
    }
  </div>
</ConsoleLayout>
