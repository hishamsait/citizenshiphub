---
import ConsoleLayout from '../../../layouts/ConsoleLayout.astro';
import { Search, ExternalLink } from 'lucide-react';
---

<ConsoleLayout
  title="Analytics — Search Console"
  description="Google Search performance: queries, impressions, CTR and position."
>
  <div class="mt-6 mx-auto max-w-xl rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
      <Search className="h-6 w-6 text-slate-400" aria-hidden="true" />
    </div>
    <h2 class="mt-4 font-display text-xl font-bold text-slate-900">Search Console is not connected</h2>
    <p class="mt-2 text-sm leading-relaxed text-slate-500">
      This screen is a slot for Google Search Console data (search queries, impressions, click-through
      rate and average position). It isn't wired up yet — the Console currently uses first-party
      analytics, and this module is ready to be pointed at the Search Console API without changes to
      the rest of the admin.
    </p>
    <div class="mt-6 rounded-xl bg-slate-50 p-4 text-left text-sm text-slate-600">
      <p class="font-semibold text-slate-900">To connect later</p>
      <ol class="mt-2 list-decimal space-y-1 pl-5">
        <li>Enable the Google Search Console API in Google Cloud.</li>
        <li>Add OAuth credentials and store the refresh token as a secret.</li>
        <li>Implement <code class="text-xs">searchConsole()</code> in the analytics provider.</li>
      </ol>
    </div>
    <a
      href="https://developers.google.com/webmaster-tools"
      target="_blank"
      rel="noopener"
      class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-800"
    >
      Search Console docs
      <ExternalLink className="h-4 w-4" aria-hidden="true" />
    </a>
  </div>
</ConsoleLayout>
