---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you requested could not be found." noindex={true}>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="text-6xl font-extrabold text-brand-200">404</p>
    <h1 class="mt-4 text-2xl font-bold text-slate-900">Page not found</h1>
    <p class="mt-2 text-slate-600">The page you're looking for doesn't exist or may have moved.</p>
    <a href="/" class="mt-6 rounded-lg bg-brand-700 px-5 py-2.5 text-sm font-semibold text-slate-50 hover:bg-brand-800">
      Back home
    </a>
  </section>
</BaseLayout>
