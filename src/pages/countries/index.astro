---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../lib/db/client';
import { listGuides } from '../../lib/db/guides';

const db = getDb(Astro.locals);
const guides = await listGuides(db);

const byRegion = new Map<string, typeof guides>();
for (const g of guides) {
  const list = byRegion.get(g.region) ?? [];
  list.push(g);
  byRegion.set(g.region, list);
}
for (const list of byRegion.values()) list.sort((a, b) => a.name.localeCompare(b.name));
const regions = [...byRegion.keys()].sort();
---

<BaseLayout
  title="Countries"
  description="Browse 199 countries see who can visit each one and how to get citizenship by descent or naturalisation."
>
  <section>
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
      <nav class="mb-4 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="transition hover:text-slate-900">Home</a>
        <span aria-hidden="true" class="mx-1.5 text-slate-300">·</span>
        <span class="text-slate-700">Countries</span>
      </nav>
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Countries</h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        Who can visit each country and how to get its passport by descent, naturalisation, or investment.
      </p>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    {
      regions.map((region) => (
        <div class="mb-8">
          <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">{region}</h2>
          <ul class="grid gap-1.5 sm:grid-cols-2 lg:grid-cols-3">
            {
              (byRegion.get(region) ?? []).map((g) => (
                <li>
                  <a
                    href={`/countries/${g.slug}/`}
                    class="flex items-center justify-between rounded-lg bg-white px-3 py-2 text-sm text-slate-700 shadow-sm hover:bg-brand-50"
                  >
                    <span>{g.name}</span>
                    <span class="font-mono text-xs text-slate-400">{g.iso2}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>
