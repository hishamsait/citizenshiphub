    <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_340px]">
      <div class="min-w-0">
        <div class="rounded-2xl bg-white p-6 shadow-lg shadow-black/5 ring-1 ring-slate-200">
          <h2 class="font-display text-xl font-bold text-slate-900">Am I eligible for {name} citizenship?</h2>
          <p class="mt-1 text-sm text-slate-500">Tap the option closest to your situation for an instant steer.</p>
          <div class="mt-4 flex flex-wrap gap-2" data-lead-context data-target-iso={iso2} data-service-type={goldenVisa ? 'Golden Visa' : 'Legal Help'}>
