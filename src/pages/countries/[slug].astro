            <p class="mt-1 text-sm text-slate-500">
              The documents you'll typically need for each citizenship route in {name}. Tick items off as you gather them
              your progress is saved on this device.
            </p>
            <DocumentsChecklist routes={checklistRoutes} iso2={iso2} />
          </section>
        )
      }

      <section id="data" class="mt-16 scroll-mt-16 border-t border-slate-200 pt-10">
        <h2 class="text-2xl font-bold text-slate-900">Country data</h2>
        <p class="mt-1 text-sm text-slate-500">Overview, citizenship routes, economy, freedom, and tax at a glance.</p>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
          {
            factSections.map((section) => (
              <div class="rounded-2xl bg-white p-6 shadow-lg shadow-black/5 ring-1 ring-slate-200">
                <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">{section.title}</h3>
                <dl class="mt-4">
                  {
                    section.facts.map((f) => (
                      <div class="flex items-center justify-between gap-4 py-2.5 text-sm">
                        <dt class="text-slate-500">{f.label}</dt>
                        <dd class="text-right font-medium text-slate-900">
                          {f.value}
                          {f.note && <span class="ml-1 text-xs font-normal text-slate-400">{f.note}</span>}
                        </dd>
                      </div>
                    ))
                  }
                </dl>
              </div>
            ))
          }
        </div>
      </section>

      <section id="travel" class="mt-16 scroll-mt-16 border-t border-slate-200 pt-10">
        <h2 class="text-2xl font-bold text-slate-900">Where the {name} passport can travel</h2>
        <p class="mt-1 text-sm text-slate-500">Each dot is a destination colours show what you need to enter.</p>

        <div class="mt-6 grid gap-8 lg:grid-cols-2">
          <div>
            <ul class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
              <li class="flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-sm" style="background-color:var(--map-visa-free)"></span>
                Visa-free
              </li>
              <li class="flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-sm" style="background-color:var(--map-visa-on-arrival)"></span>
                Visa on arrival
              </li>
              <li class="flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-sm" style="background-color:var(--map-eta)"></span>
                ETA
              </li>
              <li class="flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-sm" style="background-color:var(--map-e-visa)"></span>
                e-Visa
              </li>
              <li class="flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-sm" style="background-color:var(--map-visa-required)"></span>
                Visa required
              </li>
            </ul>

            <div class="mt-6 space-y-7">
              {
                mobilityGroups.map((g) => {
                  const summary = [
                    g.free ? `${g.free} visa-free` : '',
                    g.arrival ? `${g.arrival} on arrival` : '',
                    g.eta ? `${g.eta} ETA` : '',
                    g.evisa ? `${g.evisa} e-visa` : '',
                    g.required ? `${g.required} required` : '',
                  ]
                    .filter(Boolean)
                    .join(' · ');
                  const dots = [
                    ...Array(g.free).fill('var(--map-visa-free)'),
                    ...Array(g.arrival).fill('var(--map-visa-on-arrival)'),
                    ...Array(g.eta).fill('var(--map-eta)'),
                    ...Array(g.evisa).fill('var(--map-e-visa)'),
                    ...Array(g.required).fill('var(--map-visa-required)'),
                  ];
                  return (
                    <div>
                      <div class="flex flex-wrap items-baseline justify-between gap-2">
                        <h3 class="text-sm font-semibold text-slate-900">{g.group}</h3>
                        <span class="text-xs text-slate-400">{summary}</span>
                      </div>
                      <div class="mt-2 flex flex-wrap gap-1">
                        {dots.map((color) => (
                          <span class="h-2.5 w-2.5 rounded-[3px]" style={`background-color:${color}`}></span>
                        ))}
                      </div>
                    </div>
                  );
                })
              }
            </div>
          </div>

          <div>
            <OsmVisaMap statusByIso2={statusByIso2} />
          </div>
        </div>
      </section>

      <section id="routes" class="mt-16 scroll-mt-16 border-t border-slate-200 pt-10">
        <h2 class="text-2xl font-bold text-slate-900">Alternative paths to {name} citizenship</h2>
        <p class="mt-1 text-sm text-slate-500">Beyond standard naturalisation, these routes may apply to you.</p>
        <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            routeCards.map((route) => (
              <div class="flex flex-col rounded-2xl bg-white p-6 shadow-lg shadow-black/5 ring-1 ring-slate-200">
                <h3 class="font-display text-lg font-bold text-slate-900">{route.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{route.body}</p>
                <button
                  type="button"
                  data-lead-modal-open
                  data-service-type={route.serviceType}
                  data-target-iso={iso2}
                  data-title={`${route.title} ${name}`}
                  data-subtitle={route.body}
                  class="mt-4 inline-flex w-fit cursor-pointer items-center gap-1 bg-transparent p-0 text-left text-sm font-semibold text-brand-700 hover:text-brand-800"
                >
                  {route.cta}
                </button>
              </div>
            ))
          }
        </div>
      </section>

      {
        relatedGuides.length > 0 && (
          <section class="mt-16 border-t border-slate-200 pt-10">
            <h2 class="text-2xl font-bold text-slate-900">More citizenship guides</h2>
            <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
              {
                relatedGuides.map((g) => (
                  <CountryCard
                    slug={g.slug}
                    name={g.name}
                    iso2={g.iso2}
                    capital={g.capital ?? ''}
                    region={g.region}
                    summary={g.summary ?? ''}
                    citizenshipByDescent={g.citizenshipByDescent}
                    naturalizationYears={g.naturalizationYears}
                    dualCitizenshipAllowed={g.dualCitizenshipAllowed}
                    officialFeeEUR={g.officialFeeEUR}
                    flag={g.flag}
                  />
                ))
              }
            </div>
          </section>
        )
      }

      <section id="news" class="mt-16 scroll-mt-16 border-t border-slate-200 pt-10">
        <h2 class="text-2xl font-bold text-slate-900">Latest {name} immigration news</h2>
        <p class="mt-1 text-sm text-slate-500">Recent headlines on {name} immigration and citizenship, auto-fetched from Google News.</p>

        {
          countryNews.length > 0 ? (
            <ul class="mt-6 grid gap-4 md:grid-cols-2">
              {
                countryNews.map((n) => (
                  <li class="rounded-xl border border-slate-200 bg-white p-4">
                    <a
                      href={n.url}
                      target="_blank"
                      rel="noopener nofollow"
                      class="block font-semibold text-slate-900 hover:text-brand-700"
                    >
                      {n.title} ↗
                    </a>
                    <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-500">
                      {n.sourceName && <span class="font-medium text-slate-600">{n.sourceName}</span>}
                      {n.publishedAt && <time datetime={n.publishedAt}>{formatNewsDate(n.publishedAt)}</time>}
                    </p>
                  </li>
                ))
              }
            </ul>
          ) : (
            <p class="mt-6 rounded-lg bg-slate-100 p-4 text-sm text-slate-500">
              No recent headlines yet. Check back soon, or follow the official sources below.
            </p>
          )
        }
      </section>

      <section id="sources" class="mt-16 scroll-mt-16 border-t border-slate-200 pt-10">
        <h2 class="text-2xl font-bold text-slate-900">{name} immigration &amp; citizenship sources</h2>
        <p class="mt-1 text-sm text-slate-500">
          Official government portals and reference pages for {name} citizenship and immigration rules.
        </p>

        {
          sourceGroups.length > 0 ? (
            <div class="mt-6 space-y-8">
              {
                sourceGroups.map((group) => (
                  <div>
                    <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">{group.category}</h3>
                    <ul class="mt-3 grid gap-4 sm:grid-cols-2">
                      {
                        group.items.map((s) => (
                          <li class="flex flex-col rounded-xl border border-slate-200 bg-white p-4 text-sm text-slate-600">
                            <div class="flex items-center gap-2">
                              <img src={faviconUrl(s.url)} alt="" width="16" height="16" loading="lazy" decoding="async" class="h-4 w-4 shrink-0 rounded-sm" />
                              <a
                                href={s.url}
                                target="_blank"
                                rel="noopener nofollow"
                                class="font-semibold text-slate-900 hover:text-brand-700"
                              >
                                {s.name} ↗
                              </a>
                            </div>
                            {s.note && <p class="mt-1 text-xs text-slate-400">{s.note}</p>}
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                ))
              }
            </div>
          ) : (
            <p class="mt-6 rounded-lg bg-slate-100 p-4 text-sm text-slate-500">
              No specific sources listed yet for {name}. Refer to the general data sources below.
            </p>
          )
        }

        <details class="mt-6 rounded-xl border border-slate-200 bg-white p-4">
          <summary class="cursor-pointer text-sm font-semibold text-slate-700">General data sources &amp; licenses</summary>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {
              sources.map((s) => (
                <li class="text-sm text-slate-600">
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <img src={faviconUrl(s.url)} alt="" width="16" height="16" loading="lazy" class="h-4 w-4 shrink-0 rounded-sm" />
                    <a
                      href={s.url}
                      target="_blank"
                      rel="noopener nofollow"
                      class="font-semibold text-slate-900 hover:text-brand-700"
                    >
                      {s.name} ↗
                    </a>
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500">
                      {s.license.name}
                    </span>
                  </div>
                  <p class="mt-1">{s.provides}</p>
                  <p class="mt-1 text-xs text-slate-400">{s.attribution}</p>
                  {s.license.restrictions && (
                    <p class="mt-1 inline-block rounded bg-amber-50 px-2 py-1 text-xs text-amber-800">
                      Restrictions: {s.license.restrictions}
                    </p>
                  )}
                  {s.note && <p class="mt-1 text-xs text-amber-700">{s.note}</p>}
                </li>
              ))
            }
          </ul>
        </details>

        <p class="mt-6 rounded-lg bg-slate-100 p-4 text-xs leading-relaxed text-slate-500">
          Citizenship Hub is an independent resource and is not affiliated with, endorsed by, or sponsored by any of the
          organisations above. Informational only not legal, immigration, tax, investment, or travel advice.
          Requirements, scores, fees, and tax rates change frequently; always verify with the relevant official government
          source before acting.
        </p>
      </section>
    </div>
  </article>

  <script>
    // Reading progress bar
    const progressBar = document.getElementById('progressBar');
    if (progressBar) {
      const onScroll = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        progressBar.style.width = (max > 0 ? (doc.scrollTop / max) * 100 : 0) + '%';
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    // Country identity — reveal once the section nav is stuck under the header
    const stickySentinel = document.querySelector('[data-country-sticky-sentinel]');
    const countryBrand = document.querySelector<HTMLElement>('[data-country-brand]');
    if (stickySentinel && countryBrand && 'IntersectionObserver' in window) {
      const brandObserver = new IntersectionObserver(
        ([entry]) => {
          countryBrand.classList.toggle('is-visible', !entry.isIntersecting);
          if (entry.isIntersecting) countryBrand.setAttribute('aria-hidden', 'true');
          else countryBrand.removeAttribute('aria-hidden');
        },
        { rootMargin: '-64px 0px 0px 0px' },
      );
      brandObserver.observe(stickySentinel);
    }

    // Quick eligibility check instant positive feedback
    const leadContext = document.querySelector<HTMLElement>('[data-lead-context]');
    const leadTargetIso = leadContext?.dataset.targetIso ?? '';
    const leadServiceType = leadContext?.dataset.serviceType ?? 'Golden Visa';
    document.querySelectorAll<HTMLElement>('.qc-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const result = document.getElementById('qcResult');
        const text = document.getElementById('qcText');
        if (!result || !text) return;
        text.textContent = btn.dataset.msg || '';

        const cta = document.createElement('button');
        cta.type = 'button';
        cta.className = 'cursor-pointer font-semibold text-emerald-800 underline';
        cta.textContent = 'Get matched, free →';
        cta.addEventListener('click', () => {
          const w = window as unknown as {
            openLeadModal?: (o: { serviceType?: string; targetCountryIso?: string }) => void;
          };
          w.openLeadModal?.({ serviceType: leadServiceType, targetCountryIso: leadTargetIso });
        });
        text.appendChild(document.createTextNode(' '));
        text.appendChild(cta);

        result.classList.remove('hidden');
      });
    });

    // Lead capture POST to /api/lead so every submission persists to the DB
    document.querySelectorAll<HTMLFormElement>('.lead-form').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
        const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const email = emailInput?.value.trim() ?? '';
        if (!email) return;

        const root = form.closest<HTMLElement>('[data-lead]');
        const fields = root?.querySelector<HTMLElement>('.lead-fields');
        const done = root?.querySelector<HTMLElement>('.lead-done');
        const errorEl = root?.querySelector<HTMLElement>('.lead-error');
        const serviceType = form.dataset.serviceType || 'Golden Visa';
        const targetCountryIso = form.dataset.targetIso || '';

        if (submitBtn) submitBtn.disabled = true;
        errorEl?.classList.add('hidden');

        try {
          const res = await fetch('/api/lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, targetCountryIso, serviceType }),
          });
          if (!res.ok) throw new Error('Request failed');
          fields?.classList.add('hidden');
          done?.classList.remove('hidden');
        } catch {
          if (errorEl) {
            errorEl.textContent = 'Something went wrong please try again.';
            errorEl.classList.remove('hidden');
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    });

    // Section tab scrollspy highlight the active section's tab while scrolling
    const sectionTabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-tab]'));
    if (sectionTabs.length && 'IntersectionObserver' in window) {
      const tabSections = sectionTabs
        .map((tab) => document.getElementById(tab.dataset.tab || ''))
        .filter((el): el is HTMLElement => el !== null);
      const setActiveTab = (id: string | undefined) => {
        for (const tab of sectionTabs) {
          const active = id !== undefined && tab.dataset.tab === id;
          if (active) tab.setAttribute('aria-current', 'true');
          else tab.removeAttribute('aria-current');
        }
      };
      const tabObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) if (entry.isIntersecting) setActiveTab(entry.target.id);
        },
        { rootMargin: '-35% 0px -55% 0px' },
      );
      for (const section of tabSections) tabObserver.observe(section);

      // Highlight the hash target on load, falling back to the first section.
      const hashId = window.location.hash ? window.location.hash.slice(1) : null;
      const initialId =
        hashId && tabSections.some((s) => s.id === hashId) ? hashId : sectionTabs[0]?.dataset.tab;
      if (initialId) setActiveTab(initialId);
    }
  </script>

  <style>
    .country-prose :global(h2) {
      border-left: 3px solid var(--color-gold-500);
      padding-left: 0.9rem;
    }
    .country-prose :global(h2),
    .country-prose :global(h3) {
      scroll-margin-top: 6rem;
    }

    .country-tab[aria-current='true'] {
      background: var(--color-brand-700);
      color: var(--color-slate-50);
    }

    .country-brand {
      max-width: 0;
      opacity: 0;
      transform: translateX(1.5rem);
      transition:
        max-width 0.3s cubic-bezier(0.4, 0, 0.2, 1),
        opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .country-brand.is-visible {
      max-width: 12rem;
      opacity: 1;
      transform: translateX(0);
    }
    @media (min-width: 640px) {
      .country-brand.is-visible {
        max-width: 20rem;
      }
    }
  </style>
</BaseLayout>


