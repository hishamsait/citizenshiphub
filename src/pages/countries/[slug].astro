              >
                None of these apply to me
              </button>
            </div>
            <div id="qcResult" class="mt-4 hidden rounded-xl bg-emerald-50 p-4 text-sm leading-relaxed text-emerald-900">
              <p id="qcText"></p>
            </div>
          </div>

          <div class="country-prose prose prose-slate mt-8 max-w-none" set:html={guide.bodyHtml} />

          {
            goldenVisa && !cbi && (
              <div class="mt-8 rounded-2xl border border-gold-200 bg-gold-50 p-6">
                <p class="text-xs font-semibold uppercase tracking-widest text-gold-700">Residency by investment</p>
                <h3 class="mt-2 font-display text-xl font-bold text-slate-900">
