---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CountryCard from '../../components/CountryCard.astro';
import DocumentsChecklist from '../../components/DocumentsChecklist.astro';
import OsmVisaMap from '../../components/OsmVisaMap.astro';
import { formatEuro, formatNumber, formatArea, formatUsd, formatPercent, formatGdpUsdM, slugify, faviconUrl } from '../../lib/utils';
import { decodeCell, STATUS_LABEL, type AccessStatus } from '../../lib/visa';
import { getDb } from '../../lib/db/client';
import { getGuideBySlug, listGuides } from '../../lib/db/guides';
import { listCountries } from '../../lib/db/countries';
import { getProfile } from '../../lib/db/profiles';
import { getEconomics } from '../../lib/db/economics';
import { getFreedom } from '../../lib/db/freedom';
import { getTax } from '../../lib/db/tax';
import { getCitizenshipLaw, listCitizenshipLaws } from '../../lib/db/citizenship';
import { getDocumentsForCountry } from '../../lib/db/documents';
import { listRankings } from '../../lib/db/rankings';
import { getMatrixForPassport, getReverseMatrix } from '../../lib/db/visa';
import { listSources } from '../../lib/db/sources';
import { listCountryNews } from '../../lib/db/news';
import { listCountrySources } from '../../lib/db/country-sources';
import { listEmergencyNumbers } from '../../lib/db/emergency';
import { getRelocation } from '../../lib/db/relocation';

const db = getDb(Astro.locals);
const slug = Astro.params.slug ?? '';
const guide = await getGuideBySlug(db, slug);
if (!guide) return Astro.redirect('/countries/');

const iso2 = guide.iso2.toUpperCase();
const { name, capital, region, subregion, summary, citizenshipByDescent, naturalizationYears, dualCitizenshipAllowed, officialFeeEUR, flag } = guide;

const [profile, economics, freedom, tax, law, documents, rankings, allGuides, allLaws, sources, countryNews, countrySources, emergency, relocation, matrix, allCountries, reverse] =
  await Promise.all([
    getProfile(db, iso2),
    getEconomics(db, iso2),
    getFreedom(db, iso2),
    getTax(db, iso2),
    getCitizenshipLaw(db, iso2),
    getDocumentsForCountry(db, iso2),
    listRankings(db),
    listGuides(db),
    listCitizenshipLaws(db),
    listSources(db),
    listCountryNews(db, iso2),
    listCountrySources(db, iso2),
    listEmergencyNumbers(db, iso2),
    getRelocation(db, iso2),
    getMatrixForPassport(db, iso2),
    listCountries(db),
    getReverseMatrix(db, iso2),
  ]);

const formatNewsDate = (d: string | null) => {
  if (!d) return '';
  const date = new Date(d);
  return Number.isNaN(date.getTime())
    ? ''
    : date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
};

const mobility = rankings.find((r) => r.code === iso2) ?? null;
const countryProfile = profile;
const areaKm2 = profile?.areaKm2 ?? null;
const population = profile?.population ?? null;
const demonym = profile?.demonym ?? null;
const languages = profile?.languages ?? [];
const cbi = law?.cbi ?? null;
const goldenVisa = law?.goldenVisa ?? null;
const marriageYears = law?.marriageYears ?? null;
const languageRequired = law?.languageRequired ?? null;
const maxGenerations = law?.maxGenerations ?? null;
const birthright = law?.birthright ?? null;
const cbiMinInvestmentEUR = law?.cbiMinInvestmentEUR ?? null;
const goldenVisaMinInvestmentEUR = law?.goldenVisaMinInvestmentEUR ?? null;
const digitalNomadVisa = law?.digitalNomadVisa ?? null;
const languageLevel = law?.languageLevel ?? null;

const currencyLabel = (countryProfile?.currencies ?? [])
  .map((c) => {
    const label = c.name ?? c.code;
    return c.symbol ? `${label} (${c.symbol})` : label;
  })
  .join(', ');

const economicsFacts: { label: string; value: string; note: string | null }[] = [];
if (economics && economics.gdpPerCapitaUsd !== null) {
  economicsFacts.push({
    label: 'GDP per capita',
    value: formatUsd(economics.gdpPerCapitaUsd),
    note: economics.gdpPerCapitaYear !== null ? String(economics.gdpPerCapitaYear) : null,
  });
}
if (countryProfile?.gdpUsdM != null) {
  economicsFacts.push({
    label: 'Total GDP',
    value: formatGdpUsdM(countryProfile.gdpUsdM),
    note: countryProfile.gdpYear != null ? String(countryProfile.gdpYear) : null,
  });
}
if (economics && economics.inflationPct !== null) {
  economicsFacts.push({
    label: 'Inflation',
    value: formatPercent(economics.inflationPct),
    note: economics.inflationYear !== null ? String(economics.inflationYear) : null,
  });
}
if (economics && economics.lifeExpectancy !== null) {
  economicsFacts.push({
    label: 'Life expectancy',
    value: `${economics.lifeExpectancy.toFixed(1)} years`,
    note: economics.lifeExpectancyYear !== null ? String(economics.lifeExpectancyYear) : null,
  });
}
if (economics && economics.gdpGrowthPct !== null) {
  economicsFacts.push({
    label: 'GDP growth',
    value: formatPercent(economics.gdpGrowthPct),
    note: economics.gdpGrowthYear !== null ? String(economics.gdpGrowthYear) : null,
  });
}
if (economics && economics.hdi !== null) {
  economicsFacts.push({
    label: 'Human Development Index',
    value: economics.hdi.toFixed(3),
    note: economics.hdiRank !== null ? `#${economics.hdiRank}` : null,
  });
}
if (countryProfile?.incomeGroup) {
  economicsFacts.push({
    label: 'Income group',
    value: countryProfile.incomeGroup.replace(/^\d+\.\s*/, ''),
    note: null,
  });
}
if (countryProfile?.economy) {
  economicsFacts.push({
    label: 'Development status',
    value: countryProfile.economy.replace(/^\d+\.\s*/, ''),
    note: null,
  });
}
const freedomFacts: { label: string; value: string; note: string | null }[] = [];
const yearRankNote = (year: number | null, rank: number | null): string | null =>
  [year !== null ? String(year) : null, rank !== null ? `#${rank}` : null].filter(Boolean).join(' · ') || null;

if (freedom?.cpi && freedom.cpi.score !== null) {
  freedomFacts.push({
    label: 'Corruption Perceptions Index',
    value: `${freedom.cpi.score} / 100`,
    note: yearRankNote(freedom.cpi.year, freedom.cpi.rank),
  });
}
if (freedom?.fiw && freedom.fiw.score !== null) {
  const fiwNote = [freedom.fiw.note, freedom.fiw.year !== null ? String(freedom.fiw.year) : null]
    .filter(Boolean)
    .join(' · ');
  freedomFacts.push({ label: 'Freedom in the World', value: `${freedom.fiw.score} / 100`, note: fiwNote || null });
}
if (freedom?.humanRights && freedom.humanRights.score !== null) {
  freedomFacts.push({
    label: 'Human Rights Index',
    value: `${freedom.humanRights.score.toFixed(2)} / 1`,
    note: yearRankNote(freedom.humanRights.year, freedom.humanRights.rank),
  });
}
if (freedom?.democracy && freedom.democracy.score !== null) {
  freedomFacts.push({
    label: 'Liberal Democracy Index',
    value: `${freedom.democracy.score.toFixed(2)} / 1`,
    note: yearRankNote(freedom.democracy.year, freedom.democracy.rank),
  });
}
if (freedom?.happiness && freedom.happiness.score !== null) {
  freedomFacts.push({
    label: 'Life satisfaction',
    value: `${freedom.happiness.score.toFixed(2)} / 10`,
    note: yearRankNote(freedom.happiness.year, freedom.happiness.rank),
  });
}

const taxFacts: { label: string; value: string; note: string | null }[] = [];
if (tax?.personalIncomeTax != null) {
  taxFacts.push({ label: 'Personal income tax', value: `${tax.personalIncomeTax}%`, note: 'top rate' });
}
if (tax?.corporateTax != null) {
  taxFacts.push({ label: 'Corporate tax', value: `${tax.corporateTax}%`, note: null });
}
if (tax?.vat != null) {
  taxFacts.push({ label: 'VAT / GST', value: `${tax.vat}%`, note: null });
}
if (tax?.territorial === true) {
  taxFacts.push({ label: 'Tax basis', value: 'Territorial', note: null });
} else if (tax?.territorial === false) {
  taxFacts.push({ label: 'Tax basis', value: 'Worldwide', note: null });
}
if (tax?.wealth === true) {
  taxFacts.push({ label: 'Wealth tax', value: 'Applies', note: null });
}
if (tax?.nonDom === true) {
  taxFacts.push({ label: 'Non-dom regime', value: 'Available', note: null });
}

const lawsByIso2 = new Map(allLaws.map((l) => [l.iso2.toUpperCase(), l]));
const rankByIso2 = new Map(rankings.map((r) => [r.code, r]));

const relatedGuides = allGuides
  .filter((g) => g.slug !== slug)
  .map((g) => {
    const gIso = g.iso2.toUpperCase();
    const gLaw = lawsByIso2.get(gIso);
    const gRank = rankByIso2.get(gIso);
    return {
      guide: g,
      score: {
        sameSubregion: subregion && g.subregion === subregion ? 0 : 1,
        sameRegion: g.region === region ? 0 : 1,
        investmentAffinity: gLaw && (gLaw.goldenVisa || gLaw.cbi) ? 0 : 1,
        rankDistance:
          mobility && gRank && mobility.rank != null ? Math.abs(gRank.rank - mobility.rank) : Number.MAX_SAFE_INTEGER,
      },
    };
  })
  .sort((a, b) => {
    const s = a.score;
    const t = b.score;
    return (
      s.sameSubregion - t.sameSubregion ||
      s.sameRegion - t.sameRegion ||
      s.investmentAffinity - t.investmentAffinity ||
      s.rankDistance - t.rankDistance ||
      a.guide.name.localeCompare(b.guide.name)
    );
  })
  .map((x) => x.guide)
  .slice(0, 4);

// Documents checklist only show the routes this country actually supports
const checklistRouteOrder = ['descent', 'birthright', 'naturalisation', 'marriage', 'cbi', 'golden-visa', 'digital-nomad'];
const supportedChecklistRoutes = new Set<string>();
if (citizenshipByDescent) supportedChecklistRoutes.add('descent');
if (birthright) supportedChecklistRoutes.add('birthright');
supportedChecklistRoutes.add('naturalisation');
if (marriageYears != null) supportedChecklistRoutes.add('marriage');
if (cbi) supportedChecklistRoutes.add('cbi');
if (goldenVisa) supportedChecklistRoutes.add('golden-visa');
if (digitalNomadVisa) supportedChecklistRoutes.add('digital-nomad');
const checklistRoutes = checklistRouteOrder
  .filter((r) => supportedChecklistRoutes.has(r) && documents.some((d) => d.route === r))
  .map((r) => documents.find((d) => d.route === r)!);

// Sticky in-page tab navigation (order mirrors the sections below)
const tabs = [
  { id: 'overview', label: 'Overview' },
  { id: 'visitors', label: 'Visitors' },
  { id: 'citizenship', label: 'Citizenship' },
  ...(checklistRoutes.length > 0 ? [{ id: 'documents', label: 'Documents' }] : []),
  { id: 'data', label: 'Data' },
  { id: 'travel', label: 'Travel' },
  { id: 'routes', label: 'Routes' },
  { id: 'news', label: 'News' },
  { id: 'sources', label: 'Sources' },
];

// Passport mobility rank + donut data
const mobilityRank = mobility?.rank ?? null;
const totalRanked = rankings.length;

interface DonutSegment {
  label: string;
  value: number;
  color: string;
}

const donutSegments: DonutSegment[] = mobility
  ? [
      { label: 'Visa-free', value: mobility.visaFree, color: 'var(--map-visa-free)' },
      { label: 'Visa on arrival', value: mobility.visaOnArrival, color: 'var(--map-visa-on-arrival)' },
      { label: 'ETA', value: mobility.eta, color: 'var(--map-eta)' },
      { label: 'e-Visa', value: mobility.eVisa, color: 'var(--map-e-visa)' },
      { label: 'Visa required', value: mobility.visaRequired, color: 'var(--map-visa-required)' },
    ]
  : [];

const donutTotal = donutSegments.reduce((sum, s) => sum + s.value, 0);
const DONUT_R = 54;
const DONUT_C = 2 * Math.PI * DONUT_R;
let donutCursor = 0;
const donutArcs = donutSegments.map((s) => {
  const frac = donutTotal > 0 ? s.value / donutTotal : 0;
  const arc = { ...s, frac, offset: donutCursor };
  donutCursor += frac;
  return arc;
});

// Region-grouped mobility dot grid (destination continent from rankings)
const regionOrder = ['Europe', 'Americas', 'Asia', 'Africa', 'Oceania'];

const continentToGroup = (continent: string | null, fallback: string): string => {
  if (continent === 'North America' || continent === 'South America') return 'Americas';
  if (continent) return continent;
  return fallback || 'Other';
};

const destGroup = new Map<string, string>();
for (const r of rankings) destGroup.set(r.code, continentToGroup(r.continent, r.region));

interface GroupCounts {
  free: number;
  arrival: number;
  eta: number;
  evisa: number;
  required: number;
}

const mobilityByGroup = new Map<string, GroupCounts>();
for (const [code, cell] of Object.entries(matrix)) {
  const status = decodeCell(cell).status;
  const group = destGroup.get(code) ?? 'Other';
  const bucket = mobilityByGroup.get(group) ?? { free: 0, arrival: 0, eta: 0, evisa: 0, required: 0 };
  if (status === 'visa-free') bucket.free += 1;
  else if (status === 'visa-on-arrival') bucket.arrival += 1;
  else if (status === 'eta') bucket.eta += 1;
  else if (status === 'e-visa') bucket.evisa += 1;
  else if (status === 'visa-required') bucket.required += 1;
  mobilityByGroup.set(group, bucket);
}

const mobilityGroups = [...mobilityByGroup.entries()]
  .map(([group, counts]) => ({ group, ...counts }))
  .sort((a, b) => {
    const ia = regionOrder.indexOf(a.group);
    const ib = regionOrder.indexOf(b.group);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
  });

// World-map choropleth (access status per destination ISO2)
const statusByIso2: Record<string, AccessStatus> = {};
for (const [code, cell] of Object.entries(matrix)) {
  statusByIso2[code] = decodeCell(cell).status;
}

// Reverse look-up: which passports can visit this country (grouped by access status).
const ACCESS_GROUPS: AccessStatus[] = ['visa-free', 'visa-on-arrival', 'eta', 'e-visa'];
const visitorGroups: Record<string, { code: string; name: string; flag: string | null }[]> = {
  'visa-free': [],
  'visa-on-arrival': [],
  eta: [],
  'e-visa': [],
  'visa-required': [],
};
for (const p of allCountries) {
  const status = decodeCell(reverse[p.code] ?? '?').status;
  const bucket = visitorGroups[status];
  if (bucket) bucket.push({ code: p.code, name: p.name, flag: p.flag ?? null });
}
const visitorsAccessible = ACCESS_GROUPS.reduce((n, s) => n + (visitorGroups[s] ?? []).length, 0);
const visitorsRequired = (visitorGroups['visa-required'] ?? []).length;
const visitorsTotal = allCountries.length;

// Hero quick-fields strip
const quickFields = [
  { label: 'Capital', value: capital },
  { label: 'Mobility rank', value: mobilityRank != null ? `№ ${mobilityRank} of ${totalRanked}` : '—' },
  { label: 'By descent', value: citizenshipByDescent ? 'Yes' : 'No' },
  { label: 'Naturalisation', value: naturalizationYears === null ? 'Restricted' : `${naturalizationYears} years` },
  { label: 'Dual citizenship', value: dualCitizenshipAllowed ? 'Allowed' : 'Restricted' },
  {
    label: 'Application fee',
    value: officialFeeEUR === null ? 'Varies' : officialFeeEUR === 0 ? 'None' : formatEuro(officialFeeEUR),
  },
];

// "Good news" hero badge data-driven positive framing
const goodNews = goldenVisa
  ? 'Residency by investment (golden visa) is available here often a faster path than full naturalisation.'
  : cbi
    ? 'Direct citizenship by investment is available here.'
    : digitalNomadVisa
      ? 'A digital-nomad visa is available a flexible way to start building a route in.'
      : 'Eligibility is often wider than people expect a free check takes under a minute.';

// Alternative routes to citizenship for this country
interface RouteCard {
  title: string;
  body: string;
  cta: string;
  serviceType: string;
}

const routeCards: RouteCard[] = [];
if (goldenVisa) {
  routeCards.push({
    title: 'Residency by investment (golden visa)',
    body:
      goldenVisaMinInvestmentEUR != null
        ? `A residency-by-investment route is available from ${formatEuro(goldenVisaMinInvestmentEUR)}. It can be faster than naturalisation and often lets you keep your current nationality.`
        : 'A residency-by-investment route is available and can be faster than naturalisation.',
    cta: 'Check golden-visa eligibility →',
    serviceType: 'Golden Visa',
  });
}
if (cbi) {
  routeCards.push({
    title: 'Citizenship by investment',
    body:
      cbiMinInvestmentEUR != null
        ? `A direct citizenship-by-investment route is available from ${formatEuro(cbiMinInvestmentEUR)}.`
        : 'A direct citizenship-by-investment route is available.',
    cta: 'Check investment route →',
    serviceType: 'Citizenship by Investment',
  });
}
if (digitalNomadVisa) {
  routeCards.push({
    title: 'Digital nomad visa',
    body: 'A digital-nomad visa offers a flexible, lower-barrier way to establish a presence before committing to a full naturalisation path.',
    cta: 'Check nomad visa →',
    serviceType: 'Legal Help',
  });
}
if (routeCards.length === 0) {
  routeCards.push({
    title: 'Residency → naturalisation',
    body:
      naturalizationYears === null
        ? 'Naturalisation is discretionary here, so most applicants work through a residency or marriage route first. An advisor can map the fastest option for your situation.'
        : `Most applicants naturalise through ${naturalizationYears} years of lawful residence${marriageYears != null ? ` (reduced to ${marriageYears} years by marriage)` : ''}. An advisor can confirm your fastest route.`,
    cta: 'Get a route map, free →',
    serviceType: 'Legal Help',
  });
}

// Route-aware quick-check messages
const qcDescent = citizenshipByDescent
  ? `If you have ${demonym ?? name} parentage, you may already be a citizen an advisor can confirm the paperwork in one call.`
  : `Descent is not the main route into ${name}, but an advisor can check whether any ancestry path applies to you.`;
const qcInvest = goldenVisa
  ? `The ${name} Golden Visa (residency by investment) is the most attainable route for investors${goldenVisaMinInvestmentEUR != null ? ` up to 10-year renewable residency from about ${formatEuro(goldenVisaMinInvestmentEUR)}` : ''}. Worth a free eligibility check.`
  : cbi
    ? `A direct citizenship-by-investment route is available in ${name}${cbiMinInvestmentEUR != null ? ` from about ${formatEuro(cbiMinInvestmentEUR)}` : ''}. Worth a free eligibility check.`
    : `Investment and residency routes are often faster than full naturalisation. Worth a free eligibility check.`;
const qcSpecialist = goldenVisa
  ? `${name} actively nominates specialists and skilled professionals and the Golden Visa covers professional talent too. Worth a free eligibility check.`
  : `Many countries actively seek specialists and skilled professionals. Worth a free eligibility check.`;
const qcNone = goldenVisa
  ? `No problem the ${name} Golden Visa has broader entry criteria than citizenship, and many people qualify without realising it. A free check takes under a minute.`
  : `You may still qualify through residency, marriage, or other routes. A free check takes under a minute.`;

const overviewFacts = [
  { label: 'Capital', value: capital },
  { label: 'Region', value: region },
  ...(areaKm2 ? [{ label: 'Area', value: formatArea(areaKm2) }] : []),
  ...(population ? [{ label: 'Population', value: formatNumber(population) }] : []),
  ...(demonym ? [{ label: 'Demonym', value: demonym }] : []),
  ...(languages && languages.length > 0 ? [{ label: 'Languages', value: languages.join(', ') }] : []),
  ...(currencyLabel ? [{ label: 'Currency', value: currencyLabel }] : []),
];

const descentDepthLabel =
  maxGenerations === null
    ? 'No generational limit'
    : maxGenerations === 1
      ? 'Parents only'
      : maxGenerations === 2
        ? 'Grandparents'
        : `${maxGenerations} generations`;

const citizenshipFacts = [
  { label: 'Citizenship by descent', value: citizenshipByDescent ? 'Yes' : 'No' },
  ...(citizenshipByDescent && maxGenerations !== null
    ? [{ label: 'Descent depth', value: descentDepthLabel }]
    : []),
  ...(birthright ? [{ label: 'Citizenship by birth', value: 'Yes (jus soli)' }] : []),
  {
    label: 'Naturalisation period',
    value: naturalizationYears === null ? 'Restricted / varies' : `${naturalizationYears} years`,
  },
  ...(marriageYears !== null && marriageYears !== undefined
    ? [{ label: 'Marriage route', value: `${marriageYears} years` }]
    : []),
  ...(languageLevel
    ? [{ label: 'Language level', value: languageLevel }]
    : languageRequired !== null && languageRequired !== undefined
      ? [{ label: 'Language test', value: languageRequired ? 'Required' : 'Not required' }]
      : []),
  { label: 'Dual citizenship', value: dualCitizenshipAllowed ? 'Allowed' : 'Restricted' },
  ...(cbi
    ? [
        {
          label: 'Citizenship by investment',
          value: cbiMinInvestmentEUR != null ? `From ${formatEuro(cbiMinInvestmentEUR)}` : 'Available',
        },
      ]
    : []),
  ...(goldenVisa
    ? [
        {
          label: 'Golden visa',
          value: goldenVisaMinInvestmentEUR != null ? `From ${formatEuro(goldenVisaMinInvestmentEUR)}` : 'Available',
        },
      ]
    : []),
  ...(digitalNomadVisa ? [{ label: 'Digital nomad visa', value: 'Available' }] : []),
  {
    label: 'Official application fee',
    value:
      officialFeeEUR === null
        ? 'Varies'
        : officialFeeEUR === 0
          ? 'No application fee'
          : formatEuro(officialFeeEUR),
  },
];

const relocationFacts: { label: string; value: string; note: string | null }[] = [];
if (relocation?.internetPenetrationPct != null) {
  relocationFacts.push({ label: 'Internet penetration', value: formatPercent(relocation.internetPenetrationPct), note: relocation.internetYear != null ? String(relocation.internetYear) : null });
}
if (relocation?.drivingSide) {
  relocationFacts.push({ label: 'Driving side', value: relocation.drivingSide === 'left' ? 'Left-hand' : 'Right-hand', note: null });
}
if (relocation?.healthcareSystem) {
  relocationFacts.push({ label: 'Healthcare system', value: relocation.healthcareSystem, note: null });
}
if (relocation?.climate) {
  relocationFacts.push({ label: 'Climate', value: relocation.climate, note: null });
}
if (relocation?.timezone) {
  relocationFacts.push({ label: 'Time zone', value: relocation.timezone, note: null });
}

const sourceGroups = Array.from(
  countrySources.reduce((map, s) => {
    const key = s.category || 'Other';
    if (!map.has(key)) map.set(key, []);
    map.get(key)!.push(s);
    return map;
  }, new Map<string, typeof countrySources>()),
).map(([category, items]) => ({ category, items }));

interface Fact {
  label: string;
  value: string | null;
  note?: string | null;
}

const factSections: { title: string; facts: Fact[] }[] = [
  { title: 'Overview', facts: overviewFacts },
  { title: 'Citizenship routes', facts: citizenshipFacts },
  { title: 'Economics & development', facts: economicsFacts },
  { title: 'Freedom & quality of life', facts: freedomFacts },
  { title: 'Tax considerations', facts: taxFacts },
  { title: 'Relocation & living', facts: relocationFacts },
].filter((s) => s.facts.length > 0);

const pageUrl = new URL(Astro.url.pathname, 'https://citizenshiphub.com').href;

const faqEntries = [
  {
    q: `Can I get ${name} citizenship by descent?`,
    a: citizenshipByDescent
      ? `Yes ${name} recognises citizenship by descent${maxGenerations != null ? `, generally limited to ${maxGenerations === 1 ? 'parents' : maxGenerations === 2 ? 'grandparents' : `${maxGenerations} generations`}` : ' with no stated generational limit'}. Verify your eligibility against official sources or speak to an advisor.`
      : `Generally no ${name} does not offer a broad citizenship-by-descent route; most applicants pursue naturalisation or a residency/investment route instead.`,
  },
  {
    q: `How long does naturalisation take in ${name}?`,
    a:
      naturalizationYears === null
        ? `Naturalisation in ${name} is discretionary or restricted rather than a fixed timeline, so there is no standard processing period.`
        : `Naturalisation in ${name} typically requires ${naturalizationYears} years of lawful residence${marriageYears != null ? ` (reduced to ${marriageYears} years via marriage)` : ''}.`,
  },
  {
    q: `Does ${name} allow dual citizenship?`,
    a: dualCitizenshipAllowed
      ? `Yes ${name} generally permits dual citizenship.`
      : `${name} generally does not permit dual citizenship, so naturalising may require renouncing your existing nationality.`,
  },
];

if (goldenVisa) {
  faqEntries.push({
    q: `Does ${name} have a Golden Visa or residency-by-investment route?`,
    a: `Yes ${name} offers a residency-by-investment (golden visa) route${goldenVisaMinInvestmentEUR != null ? ` from approximately ${formatEuro(goldenVisaMinInvestmentEUR)}` : ''}, which can be faster and more attainable than full naturalisation.`,
  });
}
if (cbi) {
  faqEntries.push({
    q: `Does ${name} offer citizenship by investment?`,
    a: `Yes ${name} offers a direct citizenship-by-investment route${cbiMinInvestmentEUR != null ? ` from approximately ${formatEuro(cbiMinInvestmentEUR)}` : ''}.`,
  });
}

const howToSections = checklistRoutes
  .filter((route) => route.documents.length > 0)
  .map((route) => ({
    '@type': 'HowToSection',
    name: route.title,
    itemListElement: route.documents.map((doc) => ({
      '@type': 'HowToStep',
      name: doc.label,
      ...(doc.hint ? { text: doc.hint } : {}),
    })),
  }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: `Citizenship guide: ${name}`,
      description: summary ?? '',
      about: { '@type': 'Country', name },
      mainEntityOfPage: pageUrl,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://citizenshiphub.com/' },
        { '@type': 'ListItem', position: 2, name: 'Countries', item: 'https://citizenshiphub.com/countries/' },
        { '@type': 'ListItem', position: 3, name, item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqEntries.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    ...(howToSections.length > 0
      ? [{ '@type': 'HowTo', name: `Documents required to obtain ${name} citizenship`, step: howToSections }]
      : []),
  ],
};
