    <section class="mt-16 border-t border-slate-200 pt-10">
      <h2 class="text-2xl font-bold text-slate-900">Alternative paths to {name} citizenship</h2>
      <p class="mt-1 text-sm text-slate-500">Beyond standard naturalisation, these routes may apply to you.</p>
      <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          routeCards.map((route) => (
            <div class="flex flex-col rounded-2xl bg-white p-6 shadow-lg shadow-black/5 ring-1 ring-slate-200">
              <h3 class="font-display text-lg font-bold text-slate-900">{route.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{route.body}</p>
              <button
                type="button"
