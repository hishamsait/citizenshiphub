              </div>
              <p class="lead-error mt-3 hidden text-sm text-red-600"></p>
            </form>
            <p class="lead-done mt-3 hidden text-sm font-medium text-emerald-700">
              ✓ You're on the list we'll email you when anything changes.
            </p>
