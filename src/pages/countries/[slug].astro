            <li class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-sm" style="background-color:var(--map-visa-on-arrival)"></span>
              Visa on arrival
            </li>
            <li class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-sm" style="background-color:var(--map-eta)"></span>
              ETA
            </li>
            <li class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-sm" style="background-color:var(--map-e-visa)"></span>
              e-Visa
            </li>
            <li class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-sm" style="background-color:var(--map-visa-required)"></span>
              Visa required
            </li>
          </ul>

          <div class="mt-6 space-y-7">
            {
              mobilityGroups.map((g) => {
                const summary = [
                  g.free ? `${g.free} visa-free` : '',
                  g.arrival ? `${g.arrival} on arrival` : '',
                  g.eta ? `${g.eta} ETA` : '',
                  g.evisa ? `${g.evisa} e-visa` : '',
                  g.required ? `${g.required} required` : '',
                ]
                  .filter(Boolean)
                  .join(' · ');
                const dots = [
                  ...Array(g.free).fill('var(--map-visa-free)'),
                  ...Array(g.arrival).fill('var(--map-visa-on-arrival)'),
                  ...Array(g.eta).fill('var(--map-eta)'),
                  ...Array(g.evisa).fill('var(--map-e-visa)'),
                  ...Array(g.required).fill('var(--map-visa-required)'),
                ];
                return (
                  <div>
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                      <h3 class="text-sm font-semibold text-slate-900">{g.group}</h3>
                      <span class="text-xs text-slate-400">{summary}</span>
                    </div>
                    <div class="mt-2 flex flex-wrap gap-1">
                      {dots.map((color) => (
                        <span class="h-2.5 w-2.5 rounded-[3px]" style={`background-color:${color}`}></span>
