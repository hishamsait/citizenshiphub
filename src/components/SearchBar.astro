---
---

<form
  action="/passports/"
  method="get"
  role="search"
  class="mx-auto flex w-full max-w-xl items-center gap-2 rounded-full bg-white p-1.5 pl-5 shadow-md focus-within:ring-2 focus-within:ring-gold-400/40"
>
  <svg
    aria-hidden="true"
    class="h-5 w-5 shrink-0 text-slate-400"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m21 21-4.3-4.3"></path>
  </svg>
  <label for="hero-search" class="sr-only">Search passports by country</label>
  <input
    id="hero-search"
    type="search"
    name="q"
    placeholder="Search 199 passports — e.g. Ireland, Japan…"
    autocomplete="off"
    class="w-full bg-transparent text-slate-900 placeholder:text-slate-400 focus:outline-none"
  />
  <button
    type="submit"
    class="rounded-full bg-brand-700 px-5 py-2.5 text-sm font-semibold text-slate-50 transition hover:bg-brand-800"
  >
    Search
  </button>
</form>
