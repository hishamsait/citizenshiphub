---
import { getWorldPaths } from '../lib/map';
import { STATUS_FILL, STATUS_LABEL, type AccessStatus } from '../lib/visa';

interface Props {
  statusByIso2: Record<string, AccessStatus>;
}

const { statusByIso2 } = Astro.props;
const paths = getWorldPaths();
const legend: AccessStatus[] = ['visa-free', 'visa-on-arrival', 'eta', 'e-visa', 'visa-required', 'no-admission'];
---

<div>
  <svg viewBox="0 0 960 500" role="img" aria-label="World map of visa access" class="h-auto w-full rounded-xl bg-slate-50 shadow-sm">
    {
      paths.map((c) => {
        const status = statusByIso2[c.iso2] ?? 'unknown';
        return (
          <path d={c.d} style={`fill:${STATUS_FILL[status]};stroke:var(--map-stroke)`} stroke-width="0.5">
            <title>{`${c.name} — ${STATUS_LABEL[status]}`}</title>
          </path>
        );
      })
    }
  </svg>
  <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
    {
      legend.map((s) => (
        <li class="flex items-center gap-1.5">
          <span class="inline-block h-3 w-3 rounded-sm" style={`background-color:${STATUS_FILL[s]}`}></span>
          {STATUS_LABEL[s]}
        </li>
      ))
    }
  </ul>
</div>
