---
interface Props {
  label: string;
  value: string;
  hint?: string;
  icon?: any;
  iconClass?: string;
}

const { label, value, hint, icon: Icon, iconClass = 'text-slate-400' } = Astro.props;
---

<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <p class="text-sm font-medium text-slate-500">{label}</p>
    {
      Icon && (
        <span class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 ${iconClass}`}>
          <Icon className="h-4 w-4" aria-hidden="true" />
        </span>
      )
    }
  </div>
  <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">{value}</p>
  {hint && <p class="mt-1 text-xs text-slate-400">{hint}</p>}
</div>
