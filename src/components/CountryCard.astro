---
interface Props {
  slug: string;
  name: string;
  iso2: string;
  capital: string;
  region: string;
  summary: string;
  citizenshipByDescent: boolean;
  naturalizationYears: number | null;
  dualCitizenshipAllowed: boolean;
  officialFeeEUR: number | null;
  flag?: string | null;
}

const p = Astro.props;
---

<article
  class="group relative flex flex-col rounded-2xl bg-white p-6 shadow-lg shadow-black/5 transition hover:-translate-y-0.5 hover:shadow-xl"
>
  <div class="flex items-start justify-between">
    <div class="flex items-center gap-2">
      {p.flag && <span class="text-2xl" aria-hidden="true">{p.flag}</span>}
      <span class="inline-flex items-center rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-brand-700">
        {p.iso2}
      </span>
    </div>
    <span class="text-xs font-medium text-slate-400">{p.region}</span>
  </div>
  <h3 class="mt-3 text-lg font-semibold text-slate-900">{p.name}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{p.summary}</p>
  <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
    <div>
      <dt class="text-xs text-slate-400">Capital</dt>
      <dd class="font-medium text-slate-700">{p.capital}</dd>
    </div>
    <div>
      <dt class="text-xs text-slate-400">By descent</dt>
      <dd class="font-medium text-slate-700">{p.citizenshipByDescent ? 'Yes' : 'No'}</dd>
    </div>
    <div>
      <dt class="text-xs text-slate-400">Naturalisation</dt>
      <dd class="font-medium text-slate-700">{p.naturalizationYears === null ? 'Restricted' : `${p.naturalizationYears} yrs`}</dd>
    </div>
    <div>
      <dt class="text-xs text-slate-400">Dual citizenship</dt>
      <dd class="font-medium text-slate-700">{p.dualCitizenshipAllowed ? 'Allowed' : 'Restricted'}</dd>
    </div>
  </dl>
  <a
    href={`/countries/${p.slug}/`}
    class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800"
  >
    Read the guide <span aria-hidden="true">→</span>
  </a>
</article>
