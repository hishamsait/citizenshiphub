---
interface Props {
  rankings: { rank: number; code: string; name: string; region: string; mobilityScore: number }[];
  limit?: number;
  slugByCode?: Record<string, string>;
}

const { rankings, limit = 10, slugByCode } = Astro.props;
const rows = rankings.slice(0, limit);
---

<div class="overflow-x-auto rounded-2xl bg-white shadow-lg shadow-black/5">
  <table class="w-full min-w-[560px] text-left text-sm">
    <caption class="sr-only">Top {rows.length} passports by mobility score</caption>
    <thead class="bg-slate-100 text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th scope="col" class="px-4 py-3">Rank</th>
        <th scope="col" class="px-4 py-3">Passport</th>
        <th scope="col" class="px-4 py-3">Region</th>
        <th scope="col" class="px-4 py-3 text-right">Mobility score</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr class="even:bg-slate-50 hover:bg-slate-100">
            <td class="px-4 py-3">
              <span class="inline-flex h-6 min-w-6 items-center justify-center rounded-md bg-brand-50 px-1.5 text-xs font-bold text-brand-700">
                {r.rank}
              </span>
            </td>
            <td class="px-4 py-3 font-medium text-slate-900">
              <span class="mr-2 font-mono text-xs text-slate-400">{r.code}</span>
              {
                slugByCode?.[r.code] ? (
                  <a
                    href={`/countries/${slugByCode[r.code]}/`}
                    class="text-slate-900 underline-offset-2 hover:text-brand-700 hover:underline"
                  >
                    {r.name}
                  </a>
                ) : (
                  r.name
                )
              }
            </td>
            <td class="px-4 py-3 text-slate-500">{r.region}</td>
            <td class="px-4 py-3 text-right font-semibold text-slate-900">{r.mobilityScore}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
