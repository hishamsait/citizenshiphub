{
  "name": "citizenshiphub",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Global passport rankings, visa mobility data, and citizenship-by-descent / naturalisation guides.",
  "engines": {
    "node": "18.20.8 || >=20.3.0 <21 || >=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "fetch:data": "node scripts/fetch-passport-data.js",
    "fetch:data:fresh": "node scripts/fetch-passport-data.js --fresh",
    "fetch:profiles": "node scripts/fetch-country-profiles.js",
    "fetch:freedom": "node scripts/fetch-country-freedom.js",
    "fetch:news": "node scripts/fetch-country-news.js",
    "generate:sources": "node scripts/generate-country-sources.js",
    "generate:emergency": "node scripts/generate-country-emergency.js",
    "fetch:relocation": "node scripts/fetch-country-relocation.js",
    "db:migrate": "wrangler d1 migrations apply citizenshiphub-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply citizenshiphub-db --local",
    "db:seed:generate": "node scripts/seed-d1.mjs",
    "db:seed": "node scripts/seed-d1.mjs && wrangler d1 execute citizenshiphub-db --remote --file=scripts/.generated/seed.sql",
    "cf-typegen": "wrangler types",
    "console:totp": "node scripts/console-totp.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "generate:og:countries": "node scripts/generate-country-og-images.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^12.6.13",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/d3-geo": "^3.1.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "marked": "^18.0.13",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "wrangler": "4.86.0",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "@astrojs/language-server": "2.16.16"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
