{
  "name": "citizenshiphub",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Global passport rankings, visa mobility data, and citizenship-by-descent / naturalisation guides.",
  "engines": {
    "node": "18.20.8 || >=20.3.0 <21 || >=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "index:search": "pagefind --site dist",
    "fetch:data": "node scripts/fetch-passport-data.js",
    "fetch:data:fresh": "node scripts/fetch-passport-data.js --fresh",
    "db:migrate": "wrangler d1 migrations apply citizenshiphub-db --remote",
    "db:seed:generate": "node scripts/seed-d1.mjs",
    "db:seed": "node scripts/seed-d1.mjs && wrangler d1 execute citizenshiphub-db --remote --file=scripts/.generated/seed.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^12.6.13",
    "@tailwindcss/typography": "^0.5.16",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3",
    "wrangler": "4.86.0"
  },
  "overrides": {
    "@astrojs/language-server": "2.16.16"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
